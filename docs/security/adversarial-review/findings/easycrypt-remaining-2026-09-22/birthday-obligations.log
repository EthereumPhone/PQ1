* In [lemmas or axioms]:

lemma adaptive_randomizer_collisions:
  forall (A(S : RDraws.ASampler) <: RDraws.Adv{-RDraws.Sample}) &m,
    (forall (S <: RDraws.ASampler{-A}), islossless S.s => islossless A(S).a) =>
    hoare[ A(RDraws.Sample).a :
            List.size RDraws.Sample.l = 0 ==>
            List.size RDraws.Sample.l <= C10Counter.signing_budget] =>
    Pr[RDraws.Exp(RDraws.Sample, A).main() @ &m : ! List.uniq RDraws.Sample.l] <=
    (C10Counter.signing_budget * (C10Counter.signing_budget - 1))%r / 2%r *
    (1%r / 2%r) ^ 128.

