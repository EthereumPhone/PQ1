+            "push {{r5, r8, r9, r11, r12, lr}}", // [sp, #16] = target
+            "movw lr, #0x71C7",                // A = 0o0707070707
+            "movt lr, #0x071C",
+            "movw r9, #0xF03F",                // B = 0x3F03F03F (12-bit fold)
+            "movt r9, #0x3F03",
+            "and r5, r10, lr",
+            "and r11, lr, r10, lsr #3",
+            "add r5, r5, r11",
+            "and r11, lr, r3, lsr #1",
+            "add r5, r5, r11",
+            "and r11, lr, r3, lsr #4",
+            "add r5, r5, r11",
+            "and r11, lr, r2, lsr #2",
+            "add r5, r5, r11",
+            "and r11, lr, r2, lsr #5",
+            "add r5, r5, r11",
+            "and r11, r5, r9",
+            "and r5, r9, r5, lsr #6",
+            "add r5, r5, r11",
+            "movw r11, #0x1001",               // fields at 0, 12, 24 summed into bits 24..31
