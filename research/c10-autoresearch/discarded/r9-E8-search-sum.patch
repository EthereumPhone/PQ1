+            "add r5, r5, r11",
+            "lsr r11, r3, #31",
+            "bfi r11, r2, #1, #2",
+            "add r5, r5, r11",
+            "ldr r12, [sp, #16]",              // target
+            "add r11, r5, #77",                // digits 32..42 add at most 77
+            "cmp r11, r12",
+            "blo 68f",
+            "and r11, r1, lr",
+            "and r12, lr, r1, lsr #3",
+            "add r11, r11, r12",
+            "and r12, r11, r9",
+            "and r11, r9, r11, lsr #6",
+            "add r11, r11, r12",
+            "movw r12, #0x1001",
+            "movt r12, #0x0100",
+            "mul r11, r11, r12",
+            "add r5, r5, r11, lsr #24",
+            "lsr r11, r1, #30",
+            "bfi r11, r0, #2, #1",
+            "add r5, r5, r11",
+            "ldr r12, [sp, #16]",
+            "cmp r5, r12",
+            "ite eq",
+            "moveq r0, #1",
+            "movne r0, #0",
+            "b 66f",
+            "68:",
+            "movs r0, #0",                     // early reject
