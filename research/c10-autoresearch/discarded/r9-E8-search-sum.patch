+/// The WOTS+C count search with the digit sum in the driver (`v1-asm-search-sum`): the first
+/// `c` in `start..start + n` whose digest's digit sum (low 129 bits, 3-bit digits) is `target`;
+/// its digest to `out`. On a hit the caller's `pred` (when given) is asked about the same 32
+/// bytes the callback search would have passed it (`d[0..12]` zero), and must agree: a
+/// disagreement halts through `hash_engine_fault` (fail closed). Messages that are not of the
+/// WOTS shape go through `pqsigner_sha256_search128` with `pred` (or fault when `pred` is
+/// `None`, the test entry's case).
+#[cfg(feature = "v1-asm-search-sum")]
+#[inline(always)]
+unsafe fn v1_search_sum(
+    buf: *const u8,
+    start: u32,
+    n: u32,
+    target: u32,
+    pred: Option<unsafe extern "C" fn(*const u8) -> bool>,
+    out: *mut u8,
+) -> u32 {
+    let end = start + n;
+    if n == 0 {
+        return end;
+    }
+    // SAFETY: caller contract (128 readable bytes); unaligned word reads are legal.
+    let w = |i: usize| unsafe { buf.add(4 * i).cast::<u32>().read_unaligned() };
+    let z = w(4) | w(5) | w(6) | w(7) == 0 && (20..31).all(|i| w(i) == 0);
+    #[cfg(not(all(feature = "tick-hook", not(feature = "tick-batch"))))]
+    if z {
+        let mut st = [0u32; 48];
+        for (i, x) in st.iter_mut().take(20).enumerate() {
+            *x = w(i);
+        }
+        st[34] = target;
+        // SAFETY: caller contract.
+        unsafe { issue128(buf, start) };
+        let (c, flag) = v1_search_sum_asm(st.as_mut_ptr(), start, end);
+        if flag == 0 {
+            #[cfg(feature = "tick-batch")]
+            // SAFETY: the engine is idle; the tick does not hash.
+            unsafe {
+                pqsigner_hash_tick_n(n)
+            };
+            return end;
+        }
+        let mut d = [0u32; 8];
+        if flag == 1 {
+            collect::<false>(&mut d);
+        }
+        // SAFETY: caller contract.
+        unsafe { issue128(buf, c) };
+        collect::<true>(&mut d);
+        if let Some(p) = pred {
+            // The signer's own predicate decides: the bytes the callback search passes it.
+            let mut dz = d;
+            dz[0] = 0;
+            dz[1] = 0;
+            dz[2] = 0;
+            // SAFETY: 32 readable bytes; `pred` reads only those (caller contract).
+            if !unsafe { p(dz.as_ptr().cast::<u8>()) } {
+                hash_engine_fault();
+            }
+        }
+        // SAFETY: `out` names 32 writable bytes (caller contract).
+        unsafe { core::ptr::copy_nonoverlapping(d.as_ptr().cast::<u8>(), out, 32) };
+        #[cfg(feature = "tick-batch")]
+        // SAFETY: the engine is idle; the tick does not hash.
+        unsafe {
+            pqsigner_hash_tick_n((c - start).saturating_add(2 + u32::from(flag == 1)))
+        };
+        return c;
+    }
+    match pred {
+        // SAFETY: caller contract.
+        Some(p) => unsafe { pqsigner_sha256_search128(buf, start, n, p, out) },
+        None => {
+            let _ = (z, target);
+            hash_engine_fault()
+        }
+    }
+}
