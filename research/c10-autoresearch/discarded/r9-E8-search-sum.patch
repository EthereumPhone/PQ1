+    // SAFETY: drives only the secure HASH block (r4 = HASH_BASE); reads the 48-word staging
+    // array at `st` and writes its words 40..45; pushes and pops its own 6-word frame (8-byte
+    // aligned) around each sum; on a hang or a stale DCIS it calls `hash_engine_fault`.
+    unsafe {
+        core::arch::asm!(
+            "movw lr, #0x24",
+            "movt lr, #0x6",
+            "1:",
+            "movs r12, #{spin}",
+            "10:",
+            "subs r12, r12, #1",
+            "bne 10b",
+            "ldr r12, [r4, #0x24]",
+            "lsls r12, r12, #30",
+            "bpl 11f",
+            "4:",
+            "add r12, r4, #0x31C",            // HR3
+            "ldm r12, {{r0, r1, r2, r3, r10}}", // HR3..HR7 (raw: big-endian digest words)
+            "movs r12, #1",
+            "str r12, [r4, #0x24]",
+            "add r11, r8, #1",
+            "cmp r11, r9",
+            "beq 50f",
+            // issue try r11
+            "ldr r12, [r4, #0x24]",
+            "tst r12, #10",
+            "bne 40f",
+            "41:",
+            "str lr, [r4]",                   // INIT
+            "ldrd r12, lr, [r5]",
+            "str r12, [r4, #4]",
+            "str lr, [r4, #4]",
+            "ldrd r12, lr, [r5, #8]",
+            "str r12, [r4, #4]",
+            "str lr, [r4, #4]",
+            "movs r12, #0",
+            "str r12, [r4, #4]",
+            "str r12, [r4, #4]",
+            "str r12, [r4, #4]",
+            "str r12, [r4, #4]",
+            "ldrd r12, lr, [r5, #32]",
+            "str r12, [r4, #4]",
+            "str lr, [r4, #4]",
+            "ldrd r12, lr, [r5, #40]",
+            "str r12, [r4, #4]",
+            "str lr, [r4, #4]",
+            "ldrd r12, lr, [r5, #48]",
+            "str r12, [r4, #4]",
+            "str lr, [r4, #4]",
+            "ldrd r12, lr, [r5, #56]",
+            "str r12, [r4, #4]",
+            "str lr, [r4, #4]",
+            "ldr r12, [r5, #64]",
+            "str r12, [r4, #4]",              // word 16: block 0 starts
+            // block-0 window: park the previous try's HR words, block-1 words
+            "str r0, [r5, #160]",
+            "str r1, [r5, #164]",
+            "str r2, [r5, #168]",
+            "str r3, [r5, #172]",
+            "str r10, [r5, #176]",
+            "ldrd r0, r1, [r5, #68]",
+            "ldr r2, [r5, #76]",
+            "rev r3, r11",
+            "movs r12, #0",
+            "mov.w r10, #256",
+            "str r0, [r4, #4]",               // waits for block 0
+            "str r1, [r4, #4]",
+            "str r2, [r4, #4]",
