+/// `search128` for the WOTS+C grind with the C10 target (205) summed in the driver
+/// (`v1-asm-search-sum`). The signer links its `search128` call here (`hw-sha256-search-sum`),
+/// so the signature is `search128`'s; `pred` confirms the hit.
+///
+/// # Safety
+/// As `pqsigner_sha256_search128`; `pred` must be the WOTS+C target-205 digit-sum predicate.
+#[cfg(feature = "v1-asm-search-sum")]
+#[no_mangle]
+pub unsafe extern "C" fn pqsigner_v1_search128_wots(
+    buf: *const u8,
+    start: u32,
+    n: u32,
+    pred: unsafe extern "C" fn(*const u8) -> bool,
+    out: *mut u8,
+) -> u32 {
+    // SAFETY: this function's contract.
+    unsafe { v1_search_sum(buf, start, n, 205, Some(pred), out) }
+}
+
+/// Test entry (`v1-asm-search-sum`): the same search for any `target`, no predicate (WOTS-shape
+/// messages only).
+///
+/// # Safety
+/// As `pqsigner_sha256_search128`, without `pred`; `buf` of the WOTS shape.
+#[cfg(feature = "v1-asm-search-sum")]
+#[no_mangle]
+pub unsafe extern "C" fn pqsigner_v1_search128_target(buf: *const u8, start: u32, n: u32, target: u32, out: *mut u8) -> u32 {
+    // SAFETY: this function's contract.
+    unsafe { v1_search_sum(buf, start, n, target, None, out) }
+}
