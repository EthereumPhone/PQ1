                  "score": "CVSS:3.1/AV:P/AC:H/PR:H/UI:R/S:U/C:H/I:N/A:N",
                  "type": "CVSS_V3"
                }
              ],
              "summary": "rpassword affected by partial password reveal when input is interrupted "
            }
          ]
