+// Copyright Kani Contributors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+// kani-flags: -Z uninit-checks -Z valid-value-checks
+#![feature(core_intrinsics, custom_mir)]
+#![allow(internal_features)]
+use std::intrinsics::mir::*;
+use std::mem::MaybeUninit;
+
+#[inline(never)]
+fn before_return() {
+    kani::cover!(true, "before ordinary return read");
+}
+
+#[inline(never)]
+unsafe fn read_returned(pointer: *const u16) -> u16 {
+    unsafe { pointer.read() }
+}
+
+// Keep the implicit return place and its address in the input MIR. The return
+// itself is a typed read even though it has no explicit MIR operand.
+#[inline(never)]
+#[custom_mir(dialect = "runtime", phase = "optimized")]
+fn ordinary_return(source: *const u8) -> u16 {
+    mir! {
+        let pointer: *mut u16;
+        let bytes: *mut u8;
+        let unused: ();
+        {
+            RET = 0x1212_u16;
+            pointer = &raw mut RET;
+            bytes = CastPtrToPtr(pointer);
+            Call(unused = std::ptr::copy_nonoverlapping::<u8>(source, bytes, 1_usize), ReturnTo(copied), UnwindUnreachable())
+        }
+        copied = {
+            Call(unused = before_return(), ReturnTo(done), UnwindUnreachable())
+        }
+        done = {
+            Return()
+        }
+    }
+}
+
+#[kani::proof]
+fn initialized_ordinary_return() {
+    let byte: u8 = kani::any();
+    let value = ordinary_return(&byte);
+    let output = unsafe { read_returned(&raw const value) };
+    assert!(output.to_ne_bytes()[0] == byte);
+    kani::cover!(true, "initialized return remains observable");
+}
+
+#[kani::proof]
+fn corrupted_ordinary_return() {
+    let byte = MaybeUninit::<u8>::uninit();
+    let value = ordinary_return(byte.as_ptr());
+    let output = unsafe { read_returned(&raw const value) };
+    kani::cover!(output == 0x1207, "corrupted return remains observable");
+}
+
+#[kani::proof]
+fn explicit_read_detects_corruption() {
+    let byte = MaybeUninit::<u8>::uninit();
+    let mut value: u16 = 0x1212;
+    unsafe { std::ptr::copy_nonoverlapping(byte.as_ptr(), (&raw mut value).cast::<u8>(), 1) };
+    kani::cover!(true, "before explicit corrupted read");
+    let output = unsafe { read_returned(&raw const value) };
+    kani::cover!(output == 0x1207, "explicit corrupted read remains observable");
+}
diff --git a/tests/expected/uninit/padding-plan-check.py b/tests/expected/uninit/padding-plan-check.py
new file mode 100644
index 0000000..ede238e
--- /dev/null
+++ b/tests/expected/uninit/padding-plan-check.py
@@ -0,0 +1,91 @@
+# Copyright Kani Contributors
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+"""Strict standalone acceptance check for the disposable padding experiment.
+
+Usage: python3 padding-plan-check.py OUTPUT --harness NAME --expect valid|uninit
+       --cover DESCRIPTION --read-checks EXPECTATIONS.json
+EXPECTATIONS.json is a nonempty list of {"property": "exact check name",
+"location": "exact Location field"}, established from source and MIR.
+Run separately for every harness; regular Kani output is required. This adds
+absence/location requirements that compiletest's substring matcher cannot express.
+"""
+import argparse
+import json
+from pathlib import Path
+import re
+
+parser = argparse.ArgumentParser()
+parser.add_argument('output', type=Path)
+parser.add_argument('--harness', required=True)
+parser.add_argument('--expect', choices=['valid', 'uninit'], required=True)
+parser.add_argument('--cover', action='append', required=True)
+parser.add_argument('--read-checks', type=Path, required=True)
+args = parser.parse_args()
+errors = []
+expected_reads = json.loads(args.read_checks.read_text())
+if not isinstance(expected_reads, list) or not expected_reads or any(
+        not isinstance(p, dict) or set(p) != {'property', 'location'} or
+        any(not isinstance(v, str) or not v for v in p.values())
+        for p in expected_reads):
+    raise SystemExit('read expectations must be a nonempty list of exact property/location pairs')
+expected_names = [p['property'] for p in expected_reads]
+if len(set(expected_names)) != len(expected_names):
+    raise SystemExit('duplicate intended read property')
+sections = [s for s in re.split(r'(?=Checking harness )', args.output.read_text())
+            if s.splitlines() and s.splitlines()[0] == f'Checking harness {args.harness}...']
+if len(sections) != 1:
+    raise SystemExit('expected exactly one harness section')
+section = sections[0]
+properties = []
+for block in re.split(r'(?=Check \d+:)', section)[1:]:
+    fields = {}
+    lines = block.splitlines()
+    for field in ['Status', 'Description', 'Location']:
+        values = [x.strip().removeprefix(f'- {field}: ') for x in lines
+                  if x.strip().startswith(f'- {field}: ')]
+        if len(values) > 1:
+            errors.append(f'duplicate {field} in property')
+        fields[field] = values[0] if values else ''
+    match = re.fullmatch(r'Check \d+: (.+)', lines[0])
+    if match is None:
+        errors.append('malformed property header')
+    properties.append({'property': match[1] if match else '', **fields})
+if not properties:
+    errors.append('no property results')
+if len({p['property'] for p in properties}) != len(properties):
+    errors.append('duplicate property identity')
+failures = [p for p in properties if p['Status'] == 'FAILURE']
+# Only conclusive statuses from Kani's regular-output CheckStatus display are
+# accepted. UNKNOWN is displayed as UNDETERMINED; SMT failures use ERROR.
+conclusive = {'SUCCESS', 'FAILURE', 'SATISFIED', 'UNSATISFIABLE', 'UNREACHABLE'}
+if any(p['Status'] not in conclusive for p in properties):
+    errors.append('inconclusive, errored or unrecognized property result')
+for cover in args.cover:
+    matches = [p for p in properties if p['Description'] == json.dumps(cover)]
+    if len(matches) != 1 or matches[0]['Status'] != 'SATISFIED':
+        errors.append(f'cover not uniquely satisfied: {cover}')
+read_description = '"Undefined Behavior: Reading from an uninitialized pointer of type '
+for expected in expected_reads:
+    matches = [p for p in properties if p['property'] == expected['property']]
+    if len(matches) != 1:
+        errors.append(f'intended read not uniquely present: {expected["property"]}')
+        continue
+    observed = matches[0]
+    if '.safety_check.' not in observed['property'] or not observed['Description'].startswith(read_description):
+        errors.append('intended property was not an uninitialized-read safety check')
+    if observed['Location'] != expected['location']:
+        errors.append('intended read has the wrong exact source location')
+    if observed['Status'] != ('SUCCESS' if args.expect == 'valid' else 'FAILURE'):
+        errors.append('intended read has the wrong status')
+if args.expect == 'valid':
+    if failures or 'VERIFICATION:- SUCCESSFUL' not in section:
+        errors.append('positive harness did not verify')
+else:
+    if not failures or 'VERIFICATION:- FAILED' not in section:
+        errors.append('negative harness did not fail')
+    for failure in failures:
+        if failure['property'] not in expected_names:
+            errors.append('failure outside the intended read check set')
+print(json.dumps({'harness': args.harness, 'accepted': not errors,
+                  'errors': errors, 'failures': failures}, indent=2))
+raise SystemExit(bool(errors))
