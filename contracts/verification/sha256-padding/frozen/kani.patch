+// Copyright Kani Contributors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+
+//! Paired, synchronous transfers for owned opaque payloads. The shared predicate
+//! excludes all body replacement modes and nonordinary endpoints. Runtime events
+//! additionally reject missing producers and mismatched callees or sizes.
+
+use super::relevant_instruction::mk_ref;
+use super::*;
+use crate::args::ReachabilityType;
+use crate::kani_middle::codegen_units::CodegenUnit;
+use crate::kani_queries::QueryDb;
+use rustc_public::mir::mono::InstanceKind;
+use std::cell::RefCell;
+use std::rc::Rc;
+
+#[derive(Clone, Debug)]
+pub(crate) struct BoundaryCoverage {
+    enabled: bool,
+    // Collision-free within the codegen unit, shared by cloned passes.
+    identities: Rc<RefCell<HashMap<Instance, usize>>>,
+}
+
+impl BoundaryCoverage {
+    pub(crate) fn new(queries: &QueryDb, unit: &CodegenUnit) -> Self {
+        let args = queries.args();
+        Self {
+            enabled: unit.stubs.is_empty()
+                && matches!(args.reachability_analysis, ReachabilityType::Harnesses)
+                && !args
+                    .unstable_features
+                    .iter()
+                    .any(|flag| flag == "function-contracts" || flag == "loop-contracts"),
+            identities: Default::default(),
+        }
+    }
+
+    pub(crate) fn identity(&self, tcx: TyCtxt, instance: Instance) -> Result<usize, String> {
+        if !self.enabled
+            || instance.kind != InstanceKind::Item
+            || instance.is_foreign_item()
+            || !instance.has_body()
+            || KaniFunction::try_from(instance).is_ok()
+        {
+            return Err("Opaque transfer requires an instrumented ordinary body; stubs, harness parameters, intrinsics, shims and foreign calls are unsupported.".to_string());
+        }
+        // UninitPass visits every such body, and the excluded transformation
+        // modes are the ones that can replace an ordinary body's endpoints.
+        let body = instance.body().ok_or("Opaque transfer has no MIR body.")?;
+        if super::ptr_uninit::is_harness(instance, tcx)
+            && body.locals().iter().take(body.arg_locals().len() + 1).any(|local| {
+                super::ty_layout::contains_opaque(tcx, local.ty)
+                    && !local.ty.layout().is_ok_and(|layout| layout.shape().size.bytes() == 0)
+            })
+        {
+            return Err(
+                "Opaque harness parameters require an explicit initialization source.".into()
+            );
+        }
+        for local in body.locals().iter().take(body.arg_locals().len() + 1) {
+            let info = PointeeInfo::from_ty(tcx, local.ty).map_err(|e| e.to_string())?;
+            if !matches!(info.layout(), PointeeLayout::Sized { .. }) {
+                return Err("Opaque boundary requires supported sized arguments and return.".into());
+            }
+        }
+        if body.blocks.iter().any(|block| match &block.terminator.kind {
+            TerminatorKind::Call { unwind, .. }
+            | TerminatorKind::Drop { unwind, .. }
+            | TerminatorKind::Assert { unwind, .. } => matches!(unwind, UnwindAction::Cleanup(_)),
+            TerminatorKind::Resume => true,
+            _ => false,
+        }) {
+            return Err("Opaque transfer with unwind cleanup is unsupported.".into());
+        }
+        let mut identities = self.identities.borrow_mut();
+        let next = identities.len().checked_add(1).expect("opaque callee identity overflow");
+        Ok(*identities.entry(instance).or_insert(next))
+    }
+}
+
+#[derive(Clone, Debug)]
+pub(crate) enum BoundaryOp {
+    BeginCall { callee: usize, arguments: Vec<(usize, Operand)> },
+    Enter { callee: usize, arguments: Vec<(usize, Operand)> },
+    StoreReturn { callee: usize, place: Place },
+    LoadReturn { callee: usize, place: Place },
+}
+
+impl BoundaryOp {
+    pub(crate) fn position(&self) -> InsertPosition {
+        match self {
+            Self::LoadReturn { .. } => InsertPosition::After,
+            _ => InsertPosition::Before,
+        }
+    }
+}
+
+impl UninitInstrumenter<'_, '_> {
+    pub(super) fn build_boundary(
+        &mut self,
+        body: &mut MutableBody,
+        source: &mut SourceInstruction,
+        event: BoundaryOp,
+    ) {
+        let position = event.position();
+        match event {
+            BoundaryOp::BeginCall { callee, arguments } => {
+                // Validate all source forms before any channel or shadow mutation.
+                if arguments
+                    .iter()
+                    .any(|(_, op)| !matches!(op, Operand::Copy(_) | Operand::Move(_)))
+                {
+                    self.inject_unsupported_check(
+                        body,
+                        source,
+                        position,
+                        "Opaque constant argument requires materialized source storage.",
+                    );
+                    return;
+                }
+                for (_, operand) in &arguments {
+                    self.build_check_for_operation(
+                        body,
+                        source,
+                        MemoryInitOp::CheckRef { operand: operand.clone() },
+                    );
+                }
+                self.boundary_call(
+                    body,
+                    source,
+                    KaniModel::ClearOpaqueReturn,
+                    None,
+                    vec![],
+                    position,
+                );
+                if !arguments.is_empty() {
+                    let args =
+                        vec![number(body, source, callee), number(body, source, arguments.len())];
+                    self.boundary_call(
+                        body,
+                        source,
+                        KaniModel::ClearOpaqueArguments,
+                        None,
+                        args,
+                        position,
+                    );
+                    for (index, operand) in arguments {
+                        self.boundary_value(
+                            body,
+                            source,
+                            KaniModel::StoreOpaqueArgument,
+                            operand,
+                            &[index, callee],
+                            position,
+                        );
+                    }
+                }
+            }
+            BoundaryOp::Enter { callee, arguments } => {
+                if !arguments.is_empty() {
+                    for (index, operand) in &arguments {
+                        self.boundary_value(
+                            body,
+                            source,
+                            KaniModel::LoadOpaqueArgument,
+                            operand.clone(),
+                            &[*index, callee],
+                            position,
+                        );
+                    }
+                    let args =
+                        vec![number(body, source, callee), number(body, source, arguments.len())];
+                    self.boundary_call(
+                        body,
+                        source,
+                        KaniModel::FinishOpaqueArguments,
+                        None,
+                        args,
+                        position,
+                    );
+                    // Metadata is fully consumed before ordinary field/padding updates.
+                    for (_, operand) in arguments {
+                        self.build_check_for_operation(
+                            body,
+                            source,
+                            MemoryInitOp::SetRef { operand, value: true, position },
+                        );
+                    }
+                }
+            }
+            BoundaryOp::StoreReturn { callee, place } => {
+                let operand = Operand::Copy(place);
+                self.build_check_for_operation(
+                    body,
+                    source,
+                    MemoryInitOp::CheckRef { operand: operand.clone() },
+                );
+                self.boundary_value(
+                    body,
+                    source,
+                    KaniModel::StoreOpaqueReturn,
+                    operand,
+                    &[callee],
+                    position,
+                );
+            }
+            BoundaryOp::LoadReturn { callee, place } => {
+                let operand = Operand::Copy(place);
+                // All generated operations stay on this call's private normal edge.
+                self.boundary_value(
+                    body,
+                    source,
+                    KaniModel::LoadOpaqueReturn,
+                    operand.clone(),
+                    &[callee],
+                    position,
+                );
+                self.build_check_for_operation(
+                    body,
+                    source,
+                    MemoryInitOp::SetRef { operand, value: true, position },
+                );
+            }
+        }
+    }
+
+    fn boundary_value(
+        &mut self,
+        body: &mut MutableBody,
+        source: &mut SourceInstruction,
+        model: KaniModel,
+        operand: Operand,
+        values: &[usize],
+        position: InsertPosition,
+    ) {
+        let ty = operand.ty(body.locals()).unwrap();
+        let size = ty.layout().unwrap().shape().size.bytes();
+        let mut statements = vec![];
+        let pointer = mk_ref(&operand, body, &mut statements, source);
+        for statement in statements {
+            body.insert_stmt(statement, source, position);
+        }
+        let mut args = vec![pointer];
+        args.extend(values.iter().map(|v| number(body, source, *v)));
+        self.boundary_call(body, source, model, Some((size, ty)), args, position);
+    }
+
+    fn boundary_call(
+        &mut self,
+        body: &mut MutableBody,
+        source: &mut SourceInstruction,
+        model: KaniModel,
+        layout: Option<(usize, Ty)>,
+        args: Vec<Operand>,
+        position: InsertPosition,
+    ) {
+        let def = get_mem_init_fn_def(model.into(), self.mem_init_fn_cache);
+        let function = match layout {
+            Some((size, ty)) => resolve_mem_init_fn(def, size, ty),
+            None => Instance::resolve(def, &GenericArgs(vec![])).unwrap(),
+        };
+        let result = Place::from(body.new_local(
+            Ty::new_tuple(&[]),
+            source.span(body.blocks()),
+            Mutability::Not,
+        ));
+        body.insert_call(&function, source, position, args, result);
+    }
+}
+
+fn number(body: &MutableBody, source: &SourceInstruction, value: usize) -> Operand {
+    Operand::Constant(ConstOperand {
+        span: source.span(body.blocks()),
+        user_ty: None,
+        const_: MirConst::try_from_uint(value as u128, UintTy::Usize).unwrap(),
+    })
+}
