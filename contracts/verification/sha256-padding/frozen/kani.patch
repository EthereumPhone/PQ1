+        std::ptr::copy_nonoverlapping(source, before.cast::<u8>(), 1);
+        let after = &raw const value;
+        kani::cover!(true, "before re-addressed invalid read");
+        let result = read_u16(after);
+        kani::cover!(result == 7, "re-addressed value observable");
+        dealloc(source, layout);
