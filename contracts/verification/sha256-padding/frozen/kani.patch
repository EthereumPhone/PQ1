+
+struct Ordinary(u16);
+
+impl Drop for Ordinary {
+    #[inline(never)]
+    fn drop(&mut self) {
+        kani::cover!(self.0 == 7, "ordinary destructor reads its field");
+    }
+}
+
+#[inline(never)]
+fn produce(value: u16) -> Ordinary {
+    Ordinary(value)
+}
+
+#[inline(never)]
+fn consume(_value: Ordinary) {
+    kani::cover!(true, "before ordinary argument drop");
+}
+
+#[kani::proof]
+fn initialized_local_drop() {
+    let _value = Ordinary(kani::any());
+    kani::cover!(true, "before ordinary local drop");
+}
+
+#[kani::proof]
+fn initialized_return_and_argument_drop() {
+    let value = produce(kani::any());
+    consume(value);
+}
+
+#[kani::proof]
+fn corrupted_local_drop() {
+    use std::alloc::{Layout, alloc, dealloc};
+    let mut value = Ordinary(42);
+    unsafe {
+        let layout = Layout::new::<u8>();
+        let empty = alloc(layout);
+        kani::assume(!empty.is_null());
+        std::ptr::copy_nonoverlapping(empty, (&raw mut value).cast::<u8>(), 1);
+        dealloc(empty, layout);
+    }
+    kani::cover!(true, "before corrupted local drop");
+}
