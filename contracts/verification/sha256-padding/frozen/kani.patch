@@ -0,0 +1,133 @@
+// Copyright Kani Contributors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+// kani-flags: -Z uninit-checks -Z valid-value-checks
+#![feature(core_intrinsics, custom_mir)]
+#![allow(internal_features)]
+use std::intrinsics::mir::*;
+use std::mem::MaybeUninit;
+
+#[inline(never)]
+unsafe fn read_intrinsic(pointer: *const u16) -> u16 {
+    unsafe { std::intrinsics::read_via_copy(pointer) }
+}
+
+#[inline(never)]
+unsafe fn write_intrinsic(pointer: *mut u16, value: u16) {
+    unsafe { std::intrinsics::write_via_move(pointer, value) };
+}
+
+#[inline(never)]
+unsafe fn read_payload(value: MaybeUninit<u16>) -> u16 {
+    unsafe { value.assume_init() }
+}
+
+// Supply optimized MIR so that the exact self assignment remains a compiler
+// input. A source-only `value = value` may disappear before instrumentation.
+#[inline(never)]
+#[custom_mir(dialect = "runtime", phase = "optimized")]
+fn self_transfer(value: MaybeUninit<u16>) -> MaybeUninit<u16> {
+    mir! {
+        {
+            RET = Move(value);
+            RET = Move(RET);
+            Return()
+        }
+    }
+}
+
+#[inline(never)]
+fn return_full(value: u16) -> MaybeUninit<u16> {
+    MaybeUninit::new(value)
+}
+
+#[inline(never)]
+fn return_empty() -> MaybeUninit<u16> {
+    MaybeUninit::uninit()
+}
+
+#[inline(never)]
+fn panic_if(flag: bool) {
+    assert!(!flag);
+}
+
+#[inline(never)]
+#[custom_mir(dialect = "runtime", phase = "optimized")]
+fn opaque_cleanup(value: MaybeUninit<u16>, flag: bool) -> MaybeUninit<u16> {
+    mir! {
+        let unused: ();
+        {
+            Call(unused = panic_if(flag), ReturnTo(normal), UnwindCleanup(cleanup))
+        }
+        normal = {
+            RET = Move(value);
+            Return()
+        }
+        cleanup(cleanup) = {
+            UnwindTerminate(ReasonInCleanup)
+        }
+    }
+}
+
+#[kani::proof]
+fn read_write_intrinsics_preserve_values() {
+    let expected: u16 = kani::any();
+    let mut value = MaybeUninit::<u16>::uninit();
+    unsafe { write_intrinsic(value.as_mut_ptr(), expected) };
+    assert!(unsafe { read_intrinsic(value.as_ptr()) } == expected);
+    kani::cover!(true, "intrinsic write and read preserve value");
+}
+
+#[kani::proof]
+fn read_intrinsic_detects_empty_payload() {
+    let value = MaybeUninit::<u16>::uninit();
+    kani::cover!(true, "before empty intrinsic read");
+    let output = unsafe { read_intrinsic(value.as_ptr()) };
+    kani::cover!(output == 7, "empty intrinsic read remains observable");
+}
+
+#[kani::proof]
+fn typed_self_transfer_preserves_values() {
+    let expected: u16 = kani::any();
+    let value = self_transfer(MaybeUninit::new(expected));
+    assert!(unsafe { read_payload(value) } == expected);
+    kani::cover!(true, "typed self transfer preserves value");
+}
+
+#[kani::proof]
+fn typed_self_transfer_preserves_empty_payload() {
+    let value = self_transfer(MaybeUninit::uninit());
+    kani::cover!(true, "before empty typed self transfer read");
+    let output = unsafe { read_payload(value) };
+    kani::cover!(output == 7, "empty typed self transfer remains observable");
+}
+
+#[kani::proof]
+fn branching_calls_consume_distinct_events() {
+    let first: u16 = kani::any();
+    let second: u16 = kani::any();
+    let branch: bool = kani::any();
+    let value = if branch { return_full(first) } else { self_transfer(return_full(second)) };
+    assert!(unsafe { read_payload(value) } == if branch { first } else { second });
+    kani::cover!(branch, "direct return edge reached");
+    kani::cover!(!branch, "nested return edge reached");
+}
+
+#[kani::proof]
+fn branching_empty_return_does_not_reuse_full_event() {
+    let branch: bool = kani::any();
+    let mut value = return_full(17);
+    if branch {
+        value = self_transfer(return_empty());
+    }
+    kani::cover!(branch, "before branching empty return read");
+    let output = unsafe { read_payload(value) };
+    kani::cover!(branch && output == 7, "branching empty return remains observable");
+}
+
+#[kani::proof]
+fn opaque_unwind_cleanup_requires_refusal() {
+    let value = MaybeUninit::new(17);
+    kani::cover!(true, "before opaque cleanup boundary");
+    let output = opaque_cleanup(value, false);
+    assert!(unsafe { read_payload(output) } == 17);
+}
