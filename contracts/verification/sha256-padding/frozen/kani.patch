+/// Only owned fields carry opaque state. Pointer/reference pointees do not.
+pub fn contains_opaque(tcx: TyCtxt, ty: Ty) -> bool {
+    if is_maybe_uninit(tcx, ty) {
+        return true;
+    }
+    match ty.kind() {
+        TyKind::RigidTy(RigidTy::Adt(def, args)) => def.variants_iter().any(|variant| {
+            variant.fields().iter().any(|field| contains_opaque(tcx, field.ty_with_args(&args)))
+        }),
+        TyKind::RigidTy(RigidTy::Array(element, _) | RigidTy::Slice(element)) => {
+            contains_opaque(tcx, element)
+        }
+        TyKind::RigidTy(RigidTy::Tuple(fields)) => {
+            fields.iter().any(|field| contains_opaque(tcx, *field))
+        }
+        TyKind::RigidTy(RigidTy::Closure(_, args)) => {
+            closure_fields(tcx, &args).into_iter().any(|field| contains_opaque(tcx, field))
+        }
+        TyKind::RigidTy(RigidTy::Pat(base, _)) => contains_opaque(tcx, base),
+        _ => false,
+    }
