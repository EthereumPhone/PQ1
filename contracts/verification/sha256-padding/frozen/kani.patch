+// Copyright Kani Contributors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+
+//! Explicit local state transfers for owned MaybeUninit payloads.
+
+use super::relevant_instruction::{MemoryInitOp, mk_cast, mk_ref};
+use super::ty_layout::{contains_opaque, is_maybe_uninit};
+use super::*;
+use rustc_public::CrateDefType;
+use rustc_public::abi::FieldsShape;
+use rustc_public::mir::{CastKind, ProjectionElem};
+use rustc_public::ty::{AdtKind, ConstantKind};
+
+type OpaqueAssignmentPlan = (bool, bool, Vec<(Place, Operand)>);
+
+fn masks(tcx: TyCtxt, ty: Ty) -> Result<(Vec<bool>, Vec<bool>), String> {
+    let info = PointeeInfo::from_ty(tcx, ty).map_err(|error| error.to_string())?;
+    match info.layout() {
+        PointeeLayout::Sized { layout, preserved } => Ok((layout.clone(), preserved.clone())),
+        _ => Err(format!("Opaque transfer needs a supported sized layout: {ty}")),
+    }
+}
+
+fn constant_mask(tcx: TyCtxt, operand: &Operand) -> Result<Vec<bool>, String> {
+    let Operand::Constant(constant) = operand else { unreachable!() };
+    let ty = constant.ty();
+    let (required, _) = masks(tcx, ty)?;
+    match constant.const_.kind() {
+        ConstantKind::Allocated(allocation) => {
+            if allocation.bytes.len() != required.len() || !allocation.provenance.ptrs.is_empty() {
+                return Err("Opaque constant allocation/provenance is not supported.".to_string());
+            }
+            Ok(allocation.bytes.iter().map(Option::is_some).collect())
+        }
+        ConstantKind::ZeroSized if required.is_empty() => Ok(vec![]),
+        _ if !contains_opaque(tcx, ty) => Ok(required),
+        _ => Err("Opaque constant has no explicit initialized-byte mask.".to_string()),
+    }
+}
+
+impl UninitInstrumenter<'_, '_> {
+    pub(super) fn build_opaque_assignment(
+        &mut self,
+        body: &mut MutableBody,
+        source: &mut SourceInstruction,
+        destination: Place,
+        rvalue: Rvalue,
+    ) {
+        let plan = self.opaque_assignment_plan(body, &destination, &rvalue);
+        let (aggregate, cast, pieces) = match plan {
+            Ok(plan) => plan,
+            Err(reason) => {
+                self.inject_unsupported_check(body, source, InsertPosition::Before, &reason);
+                return;
+            }
+        };
+        // All source checks precede every shadow mutation. In particular an
+        // aggregate cannot erase a source before a later operand reads it.
+        for (target, operand) in &pieces {
+            match operand {
+                Operand::Copy(_) | Operand::Move(_) => {
+                    let operation = if cast {
+                        MemoryInitOp::CheckRefAs {
+                            operand: operand.clone(),
+                            pointee_ty: target.ty(body.locals()).unwrap(),
+                        }
+                    } else {
+                        MemoryInitOp::CheckRef { operand: operand.clone() }
+                    };
+                    self.build_check_for_operation(body, source, operation);
+                }
+                Operand::Constant(_) => {
+                    let required_ty = if cast {
+                        target.ty(body.locals()).unwrap()
+                    } else {
+                        operand.ty(body.locals()).unwrap()
+                    };
+                    let (required, _) = masks(self.tcx, required_ty).unwrap();
+                    let initialized = constant_mask(self.tcx, operand).unwrap();
+                    if required
+                        .iter()
+                        .zip(initialized)
+                        .any(|(required, initialized)| *required && !initialized)
+                    {
+                        self.inject_safety_check(body, source, InsertPosition::Before,
+                            "Undefined Behavior: Reading uninitialized data from an opaque constant.");
+                    }
+                }
+                Operand::RuntimeChecks(_) => unreachable!(),
+            }
+        }
+        if aggregate {
+            let size =
+                destination.ty(body.locals()).unwrap().layout().unwrap().shape().size.bytes();
+            self.write_exact_mask(body, source, &destination, &vec![false; size]);
+        }
+        for (target, operand) in pieces {
+            match &operand {
+                Operand::Constant(_) => {
+                    self.write_exact_mask(
+                        body,
+                        source,
+                        &target,
+                        &constant_mask(self.tcx, &operand).unwrap(),
+                    );
+                }
+                Operand::Copy(from) | Operand::Move(from) if *from == target => {}
+                Operand::Copy(_) | Operand::Move(_) => {
+                    let ty = target.ty(body.locals()).unwrap();
+                    let size = ty.layout().unwrap().shape().size.bytes();
+                    if size == 0 {
+                        continue;
+                    }
+                    let mut statements = vec![];
+                    let from = mk_ref(&operand, body, &mut statements, source);
+                    let from = mk_cast(&from, ty, body, &mut statements, source);
+                    let to = mk_ref(&Operand::Copy(target), body, &mut statements, source);
+                    for statement in statements {
+                        body.insert_stmt(statement, source, InsertPosition::Before);
+                    }
+                    let function = resolve_mem_init_fn(
+                        get_mem_init_fn_def(KANI_COPY_INIT_STATE_SINGLE, self.mem_init_fn_cache),
+                        size,
+                        ty,
+                    );
+                    let result = Place::from(body.new_local(
+                        Ty::new_tuple(&[]),
+                        source.span(body.blocks()),
+                        Mutability::Not,
+                    ));
+                    body.insert_call(
+                        &function,
+                        source,
+                        InsertPosition::Before,
+                        vec![from, to],
+                        result,
+                    );
+                }
+                Operand::RuntimeChecks(_) => unreachable!(),
+            }
+        }
+    }
+
+    fn opaque_assignment_plan(
+        &self,
+        body: &MutableBody,
+        destination: &Place,
+        rvalue: &Rvalue,
+    ) -> Result<OpaqueAssignmentPlan, String> {
+        let destination_ty = destination.ty(body.locals()).unwrap();
+        masks(self.tcx, destination_ty)?;
+        let (aggregate, cast, pieces) = match rvalue {
+            Rvalue::Use(operand, _) => (false, false, vec![(destination.clone(), operand.clone())]),
+            Rvalue::Cast(CastKind::Transmute, operand, _) => {
+                let (from_required, from_preserved) =
+                    masks(self.tcx, operand.ty(body.locals()).unwrap())?;
+                let (to_required, _) = masks(self.tcx, destination_ty)?;
+                if from_required.len() != to_required.len()
+                    || to_required.iter().enumerate().any(|(idx, required)| {
+                        *required && !from_required[idx] && !from_preserved[idx]
+                    })
+                {
+                    return Err(
+                        "Opaque cast exposes ordinary padding or changes storage size.".to_string()
+                    );
+                }
+                (false, true, vec![(destination.clone(), operand.clone())])
+            }
+            Rvalue::Aggregate(kind, operands) => {
+                let projections: Vec<ProjectionElem> = match kind {
+                    AggregateKind::Adt(def, variant, args, _, active) => {
+                        if def.kind() == AdtKind::Union
+                            && !is_maybe_uninit(self.tcx, destination_ty)
+                        {
+                            return Err("General union opaque aggregate transfer is unsupported."
+                                .to_string());
+                        }
+                        if def.kind() == AdtKind::Enum {
+                            return Err(
+                                "Opaque enum aggregate transfer is unsupported.".to_string()
+                            );
+                        }
+                        let fields = def.variant(*variant).unwrap().fields();
+                        let indices: Vec<_> = match active {
+                            Some(field) => vec![*field],
+                            None => (0..fields.len()).collect(),
+                        };
+                        indices
+                            .into_iter()
+                            .map(|idx| ProjectionElem::Field(idx, fields[idx].ty_with_args(args)))
+                            .collect()
+                    }
+                    AggregateKind::Tuple => operands
+                        .iter()
+                        .enumerate()
+                        .map(|(idx, operand)| {
+                            ProjectionElem::Field(idx, operand.ty(body.locals()).unwrap())
+                        })
+                        .collect(),
+                    AggregateKind::Array(_) => (0..operands.len())
+                        .map(|idx| ProjectionElem::ConstantIndex {
+                            offset: idx as u64,
+                            min_length: operands.len() as u64,
+                            from_end: false,
+                        })
+                        .collect(),
+                    _ => return Err("Unsupported opaque aggregate kind.".to_string()),
+                };
+                if projections.len() != operands.len() {
+                    return Err("Opaque aggregate operand/field count mismatch.".to_string());
+                }
+                let pieces = projections
+                    .into_iter()
+                    .zip(operands.iter())
+                    .map(|(projection, operand)| {
+                        let mut field = destination.clone();
+                        field.projection.push(projection);
+                        (field, operand.clone())
+                    })
+                    .collect();
+                (true, false, pieces)
+            }
+            Rvalue::Repeat(operand, _) => {
+                let shape = destination_ty.layout().unwrap().shape();
+                let FieldsShape::Array { count, .. } = shape.fields else {
+                    return Err("Opaque repetition needs a fixed-array layout.".to_string());
+                };
+                let pieces = (0..count)
+                    .map(|index| {
+                        let mut field = destination.clone();
+                        field.projection.push(ProjectionElem::ConstantIndex {
+                            offset: index,
+                            min_length: count,
+                            from_end: false,
+                        });
+                        (field, operand.clone())
+                    })
+                    .collect();
+                (true, false, pieces)
+            }
+            _ => return Err("Opaque assignment form has no state-transfer model.".to_string()),
+        };
+        // Compile-time disjointness is intentionally conservative. Different
+        // live local objects are disjoint; direct exact self-copy is supported.
+        // Other aliasing, including sources in an aggregate destination, refuses.
+        for (target, operand) in &pieces {
+            let (source_required, _) = masks(self.tcx, operand.ty(body.locals()).unwrap())?;
+            let (target_required, _) = masks(self.tcx, target.ty(body.locals()).unwrap())?;
+            if source_required.len() != target_required.len() {
+                return Err("Opaque transfer has mismatched source/destination sizes.".to_string());
+            }
+            match operand {
+                Operand::Copy(from) | Operand::Move(from) if !source_required.is_empty() => {
+                    let exact_self = !aggregate && *from == *target;
+                    // A reference argument points into caller-owned storage,
+                    // which is disjoint from this invocation's own MIR locals.
+                    // Raw pointers and arbitrary dereference chains retain refusal.
+                    let caller_storage = from.local > 0
+                        && from.local <= body.arg_count()
+                        && from.projection.first() == Some(&ProjectionElem::Deref)
+                        && from.projection.iter().filter(|p| **p == ProjectionElem::Deref).count()
+                            == 1
+                        && matches!(
+                            body.locals()[from.local].ty.kind(),
+                            TyKind::RigidTy(RigidTy::Ref(..))
+                        )
+                        && (destination.local == 0 || destination.local > body.arg_count());
+                    let disjoint = from.local != destination.local
+                        && (!from.projection.contains(&ProjectionElem::Deref) || caller_storage)
+                        && !destination.projection.contains(&ProjectionElem::Deref);
+                    if !exact_self && !disjoint {
+                        return Err(
+                            "Opaque transfer overlap is not proved disjoint or exact self-copy."
+                                .to_string(),
+                        );
+                    }
+                }
+                Operand::Constant(_) => {
+                    constant_mask(self.tcx, operand)?;
+                }
+                Operand::RuntimeChecks(_) => {
+                    return Err("Unsupported opaque runtime-check operand.".to_string());
+                }
+                _ => {}
+            }
+        }
+        Ok((aggregate, cast, pieces))
+    }
+
+    fn write_exact_mask(
+        &mut self,
+        body: &mut MutableBody,
+        source: &mut SourceInstruction,
+        target: &Place,
+        mask: &[bool],
+    ) {
+        if mask.is_empty() {
+            return;
+        }
+        let ty = target.ty(body.locals()).unwrap();
+        let mut statements = vec![];
+        let pointer = mk_ref(&Operand::Copy(target.clone()), body, &mut statements, source);
+        let layout = mk_layout_operand(body, &mut statements, source, mask);
+        for statement in statements {
+            body.insert_stmt(statement, source, InsertPosition::Before);
+        }
+        let function = resolve_mem_init_fn(
+            get_mem_init_fn_def(KANI_SET_PTR_INITIALIZED, self.mem_init_fn_cache),
+            mask.len(),
+            ty,
+        );
+        let value = Operand::Constant(ConstOperand {
+            span: source.span(body.blocks()),
+            user_ty: None,
+            const_: MirConst::from_bool(true),
+        });
+        let result = Place::from(body.new_local(
+            Ty::new_tuple(&[]),
+            source.span(body.blocks()),
+            Mutability::Not,
+        ));
+        body.insert_call(
+            &function,
+            source,
+            InsertPosition::Before,
+            vec![pointer, layout, value],
+            result,
+        );
+    }
+}
