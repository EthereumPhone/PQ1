+// kani-flags: -Z uninit-checks -Z valid-value-checks
+// Draft controls; run padding-plan-check.py as well as compiletest.
+
+use std::mem::MaybeUninit;
+
+#[inline(never)]
+fn retain_field_address(pointer: *mut u8) -> *mut u8 {
+    pointer
+}
+
+#[inline(never)]
+unsafe fn read_initialized_u8(pointer: *const u8) -> u8 {
+    unsafe { *pointer }
+}
+
+#[inline(never)]
+unsafe fn read_tuple_payload(value: MaybeUninit<(u8, u8)>) -> (u8, u8) {
+    unsafe { value.assume_init() }
+}
+
+#[kani::proof]
+fn ordinary_local_raw_read() {
+    let value: u8 = kani::any();
+    let pointer = &raw const value;
+    assert!(unsafe { read_initialized_u8(pointer) } == value);
+    kani::cover!(true, "ordinary local raw read succeeds");
+}
+
+#[kani::proof]
+fn field_address_does_not_initialize_payload() {
+    let mut value = MaybeUninit::<(u8, u8)>::uninit();
+    let pointer = value.as_mut_ptr();
+    // Inspect the implementation's MIR before accepting this control: the
+    // field AddressOf must remain, rather than being optimized away.
+    let first = unsafe { std::ptr::addr_of_mut!((*pointer).0) };
+    let first = retain_field_address(first);
+    unsafe { (*pointer).1 = 3 };
+    kani::cover!(
+        first == pointer.cast::<u8>(),
+        "before invalid read after taking an unwritten field address"
+    );
+    let output = unsafe { read_tuple_payload(value) };
+    kani::cover!(output.0 == 7, "unwritten field remains observable");
+}
