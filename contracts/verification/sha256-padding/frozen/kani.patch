+// Copyright Kani Contributors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+// Draft acceptance harnesses for docs/padding-memory-plan.md.
+// Positive and deliberately invalid cases are named separately; no expected
+// success is claimed on the baseline compiler.
+// kani-flags: -Z uninit-checks -Z valid-value-checks --default-unwind 5
+
+use std::mem::MaybeUninit;
+
+#[derive(Clone, Copy)]
+struct Container {
+    before: u8,
+    payload: MaybeUninit<[u8; 4]>,
+    after: u8,
+}
+
+#[inline(never)]
+fn return_second(_first: Container, second: Container) -> Container {
+    identity(second)
+}
+
+#[inline(never)]
+fn identity(value: Container) -> Container {
+    value
+}
+
+#[inline(never)]
+unsafe fn read_bytes(value: MaybeUninit<[u8; 4]>) -> [u8; 4] {
+    unsafe { value.assume_init() }
+}
+
+#[kani::proof]
+fn preserves_initialized_payload() {
+    let bytes: [u8; 4] = kani::any();
+    let before: u8 = kani::any();
+    let after: u8 = kani::any();
+    let first = Container { before: 0, payload: MaybeUninit::uninit(), after: 0 };
+    let second = Container { before, payload: MaybeUninit::new(bytes), after };
+    let moved = return_second(first, second);
+    let output = unsafe { read_bytes(moved.payload) };
+    for i in 0..4 {
+        assert!(output[i] == bytes[i]);
+    }
+    assert!(moved.before == before && moved.after == after);
+    kani::cover!(output[0] != output[3], "distinct endpoint bytes survive");
+}
+
+#[kani::proof]
+fn detects_uninitialized_payload_after_call() {
+    let empty = Container { before: 1, payload: MaybeUninit::uninit(), after: 2 };
+    let full = Container { before: 1, payload: MaybeUninit::new([3; 4]), after: 2 };
+    let moved = return_second(full, empty);
+    kani::cover!(true, "before invalid read after nested call");
+    let output = unsafe { read_bytes(moved.payload) };
+    kani::cover!(output[0] == 7, "invalid read must be rejected");
+}
+
+#[kani::proof]
+fn detects_missing_last_write() {
+    let mut value = Container { before: 1, payload: MaybeUninit::uninit(), after: 2 };
+    let ptr = value.payload.as_mut_ptr().cast::<u8>();
+    for i in 0..3 {
+        unsafe { ptr.add(i).write(kani::any()) };
+    }
+    let moved = identity(value);
+    kani::cover!(true, "before invalid read after missing last write");
+    let output = unsafe { read_bytes(moved.payload) };
+    kani::cover!(output[3] == 7, "unwritten last byte must be rejected");
+}
+
+#[kani::proof]
+fn detects_replacing_initialized_payload() {
+    let mut value = Container { before: 1, payload: MaybeUninit::new([3; 4]), after: 2 };
+    value.payload = MaybeUninit::uninit();
+    let moved = identity(value);
+    kani::cover!(true, "before invalid read after replacing payload");
+    let output = unsafe { read_bytes(moved.payload) };
+    kani::cover!(output[0] == 7, "overwritten initialization must be rejected");
+}
+
+#[kani::proof]
+fn byte_copy_preserves_initialized_prefix() {
+    let source: [u8; 4] = kani::any();
+    let mut output = [0u8; 4];
+    let n: usize = kani::any();
+    kani::assume(n <= 4);
+    output[..n].copy_from_slice(&source[..n]);
+    for i in 0..4 {
+        assert!(output[i] == if i < n { source[i] } else { 0 });
+    }
+    kani::cover!(n == 0, "zero byte copy");
+    kani::cover!(n == 4, "full byte copy");
+}
+
+#[kani::proof]
+fn byte_copy_does_not_initialize_source() {
+    let source = MaybeUninit::<[u8; 4]>::uninit();
+    let mut dest = MaybeUninit::<[u8; 4]>::uninit();
+    unsafe {
+        std::ptr::copy_nonoverlapping(
+            source.as_ptr().cast::<u8>(),
+            dest.as_mut_ptr().cast::<u8>(),
+            4,
+        );
+    }
+    kani::cover!(true, "before invalid read after copying uninitialized bytes");
+    let output = unsafe { read_bytes(dest) };
+    kani::cover!(output[0] == 7, "copied uninitialized byte must be rejected");
+}
