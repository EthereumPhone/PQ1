+// Copyright Kani Contributors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+// kani-flags: -Z uninit-checks -Z valid-value-checks
+
+// Capability boundary: this valid program is refused until static initializer
+// state is modeled. Taking a reference must not repair previously corrupted
+// storage. This is not an uninitialized-read negative control.
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+static GLOBAL_ATOMIC: AtomicUsize = AtomicUsize::new(0);
+
+#[kani::proof]
+fn global_atomic_requires_initializer_model() {
+    let ordering = match kani::any() {
+        0 => Ordering::Relaxed,
+        1 => Ordering::Release,
+        2 => Ordering::Acquire,
+        3 => Ordering::AcqRel,
+        _ => Ordering::SeqCst,
+    };
+    let _old_value = GLOBAL_ATOMIC.fetch_add(1, ordering);
+}
