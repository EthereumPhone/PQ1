+// Copyright Kani Contributors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+// Draft controls for existing plan items 1-3, not accepted baseline proofs.
+// kani-flags: -Z uninit-checks -Z valid-value-checks
+use std::mem::MaybeUninit;
+
+#[derive(Clone, Copy)]
+#[repr(C)]
+struct Padded {
+    prefix: u8,
+    payload: MaybeUninit<u16>,
+    suffix: u8,
+    empty: MaybeUninit<()>,
+}
+
+#[inline(never)]
+fn identity(value: Padded) -> Padded {
+    value
+}
+
+#[inline(never)]
+fn choose(first: Padded, second: Padded, take_first: bool) -> Padded {
+    if take_first { identity(first) } else { identity(second) }
+}
+
+#[inline(never)]
+unsafe fn read_payload(value: Padded) -> u16 {
+    unsafe { value.payload.assume_init() }
+}
+
+fn make(payload: MaybeUninit<u16>, prefix: u8, suffix: u8) -> Padded {
+    Padded { prefix, payload, suffix, empty: MaybeUninit::uninit() }
+}
+
+#[kani::proof]
+fn both_positions_padded_and_zero_size_preserve_values() {
+    let first: u16 = kani::any();
+    let second: u16 = kani::any();
+    let take_first: bool = kani::any();
+    let value = choose(
+        make(MaybeUninit::new(first), 3, 5),
+        make(MaybeUninit::new(second), 7, 9),
+        take_first,
+    );
+    let result = unsafe { read_payload(value) };
+    unsafe { value.empty.assume_init() };
+    assert!(result == if take_first { first } else { second });
+    assert!(value.prefix == if take_first { 3 } else { 7 });
+    assert!(value.suffix == if take_first { 5 } else { 9 });
+    kani::cover!(take_first, "first argument preserved");
+    kani::cover!(!take_first, "second argument preserved");
+}
+
+#[kani::proof]
+fn first_argument_empty_survives_nested_return() {
+    let value = choose(make(MaybeUninit::uninit(), 3, 5), make(MaybeUninit::new(17), 7, 9), true);
+    kani::cover!(true, "before invalid read from first argument");
+    let result = unsafe { read_payload(value) };
+    kani::cover!(result == 7, "first argument read observable");
+}
+
+#[kani::proof]
+fn second_argument_empty_survives_nested_return() {
+    let value = choose(make(MaybeUninit::new(17), 3, 5), make(MaybeUninit::uninit(), 7, 9), false);
+    kani::cover!(true, "before invalid read from second argument");
+    let result = unsafe { read_payload(value) };
+    kani::cover!(result == 7, "second argument read observable");
+}
+
+struct ReadOnDrop {
+    payload: MaybeUninit<u16>,
+}
+
+impl Drop for ReadOnDrop {
+    #[inline(never)]
+    fn drop(&mut self) {
+        let result = unsafe { self.payload.assume_init() };
+        kani::cover!(result == 7, "drop read observable");
+    }
+}
+
+#[kani::proof]
+fn drop_does_not_initialize_opaque_payload() {
+    let value = ReadOnDrop { payload: MaybeUninit::uninit() };
+    kani::cover!(true, "before invalid read in drop");
+    drop(value);
+}
+
+#[inline(never)]
+fn other_identity(value: Padded) -> Padded {
+    value
+}
+
+#[kani::proof]
+fn indirect_opaque_call_requires_refusal() {
+    let take_first: bool = kani::any();
+    let target: fn(Padded) -> Padded = if take_first { identity } else { other_identity };
+    let value = make(MaybeUninit::new(17), 3, 5);
+    kani::cover!(take_first, "before first indirect target");
+    kani::cover!(!take_first, "before second indirect target");
+    let result = target(value);
+    assert!(unsafe { read_payload(result) } == 17);
+}
