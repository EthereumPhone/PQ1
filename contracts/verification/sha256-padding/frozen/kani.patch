+/// Identify the actual standard-library union, never a user type with the same name.
+pub fn is_maybe_uninit(tcx: TyCtxt, ty: Ty) -> bool {
+    let TyKind::RigidTy(RigidTy::Adt(def, _)) = ty.kind() else { return false };
