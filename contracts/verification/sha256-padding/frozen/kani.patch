+// Copyright Kani Contributors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+// kani-flags: -Z uninit-checks -Z valid-value-checks --default-unwind 4
+use std::mem::MaybeUninit;
+
+#[derive(Clone, Copy)]
+#[repr(C)]
+struct Packet {
+    tag: u16,
+    payload: MaybeUninit<u16>,
+    tail: u8,
+}
+
+#[inline(never)]
+unsafe fn read_payload(value: MaybeUninit<u16>) -> u16 {
+    unsafe { value.assume_init() }
+}
+
+#[inline(never)]
+unsafe fn read_pointer(value: *const u16) -> u16 {
+    unsafe { *value }
+}
+
+#[inline(never)]
+fn empty_return() -> MaybeUninit<u16> {
+    MaybeUninit::uninit()
+}
+
+#[inline(never)]
+fn full_return(value: u16) -> MaybeUninit<u16> {
+    MaybeUninit::new(value)
+}
+
+#[inline(never)]
+fn aggregate_return(value: [(u8, Packet); 2]) -> [(u8, Packet); 2] {
+    value
+}
+
+#[kani::proof]
+fn array_tuple_aggregate_preserves_values() {
+    let first: u16 = kani::any();
+    let second: u16 = kani::any();
+    let a = Packet { tag: 3, payload: MaybeUninit::new(first), tail: 5 };
+    let b = Packet { tag: 7, payload: MaybeUninit::new(second), tail: 9 };
+    let values = [(11, a), (13, b)];
+    let values = aggregate_return(values);
+    assert!(unsafe { read_payload(values[0].1.payload) } == first);
+    assert!(unsafe { read_payload(values[1].1.payload) } == second);
+    assert!(values[0].0 == 11 && values[1].0 == 13);
+    assert!(values[0].1.tag == 3 && values[1].1.tail == 9);
+    kani::cover!(first != second, "array tuple payloads survive");
+}
+
+#[kani::proof]
+fn full_return_overwrites_initialized_destination() {
+    let mut value = MaybeUninit::new(17u16);
+    let before = &raw const value;
+    let expected: u16 = kani::any();
+    value = full_return(expected);
+    assert!(before == &raw const value);
+    assert!(unsafe { read_payload(value) } == expected);
+    kani::cover!(expected != 17, "full return replaces old value");
+}
+
+#[kani::proof]
+fn empty_return_overwrites_initialized_destination() {
+    let mut value = MaybeUninit::new(17u16);
+    let before = &raw const value;
+    value = empty_return();
+    kani::cover!(before == &raw const value, "before empty return overwrite read");
+    let output = unsafe { read_payload(value) };
+    kani::cover!(output == 7, "empty overwrite remains observable");
+}
+
+#[kani::proof]
+fn delayed_pointer_detects_empty_return() {
+    let mut value = MaybeUninit::new(17u16);
+    let pointer = (&raw const value).cast::<u16>();
+    value = empty_return();
+    kani::cover!(pointer == (&raw const value).cast::<u16>(), "before delayed pointer read");
+    let output = unsafe { read_pointer(pointer) };
+    kani::cover!(output == 7, "delayed pointer value observable");
+}
+
+#[kani::proof]
+fn self_byte_copy_preserves_initialized_payload() {
+    let expected: u16 = kani::any();
+    let mut value = MaybeUninit::new(expected);
+    let pointer = value.as_mut_ptr().cast::<u8>();
+    unsafe { std::ptr::copy(pointer, pointer, 2) };
+    assert!(unsafe { read_payload(value) } == expected);
+    kani::cover!(true, "self byte copy preserves data");
+}
+
+#[kani::proof]
+fn self_byte_copy_preserves_uninitialized_payload() {
+    let mut value = MaybeUninit::<u16>::uninit();
+    let pointer = value.as_mut_ptr().cast::<u8>();
+    unsafe { std::ptr::copy(pointer, pointer, 2) };
+    kani::cover!(true, "before uninitialized self copy read");
+    let output = unsafe { read_payload(value) };
+    kani::cover!(output == 7, "uninitialized self copy observable");
+}
+
+#[kani::proof]
+fn repeated_storage_does_not_retain_previous_initialization() {
+    for iteration in 0..2 {
+        let value = if iteration == 0 { full_return(17) } else { empty_return() };
+        if iteration == 1 {
+            kani::cover!(true, "before second lifetime read");
+            let output = unsafe { read_payload(value) };
+            kani::cover!(output == 7, "second lifetime value observable");
+        }
+    }
+}
+
+#[inline(never)]
+unsafe fn raw_aggregate_copy(from: *const Packet, to: *mut Packet) {
+    unsafe { *to = *from };
+}
+
+#[kani::proof]
+fn raw_aggregate_aliasing_requires_refusal() {
+    let mut value = Packet { tag: 3, payload: MaybeUninit::new(17), tail: 5 };
+    let pointer = &raw mut value;
+    unsafe { raw_aggregate_copy(pointer, pointer) };
+    assert!(unsafe { read_payload(value.payload) } == 17);
+}
+
+#[inline(never)]
+fn build_with<F: FnMut() -> u16>(mut generator: F) -> Packet {
+    Packet { tag: 3, payload: MaybeUninit::new(generator()), tail: 5 }
+}
+
+#[kani::proof]
+fn zero_sized_closure_can_build_opaque_return() {
+    let value = build_with(|| 17);
+    assert!(unsafe { read_payload(value.payload) } == 17);
+    kani::cover!(true, "zero sized generator returns initialized payload");
+}
