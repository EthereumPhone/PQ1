/-
SphincsCVerify.Interpreter.C10HeadParse — the in-kernel parse theorem for the OPTIMIZED v1
verifier. RESEARCH (#1155 gas track, batch 6).

`parse_c10_head : parseYulFuel headFuel c10HeadSource = some c10HeadProgram` by `rfl`: the
kernel runs the (extended) tokenizer + parser over the optimized `SPHINCsC10Asm.sol` assembly
interior and compares the AST with the literal `c10HeadProgram`. The literal is generated by
the same parser (research/c10-gas/gen_lean_head.py), so this theorem PINS the literal to the
source; it is not an independent transcription check. Together with `parse_c10` (unchanged,
re-checked against the extended parser) it fixes both programs the relational theorem
`execHead = execC10Asm` will relate.

Mathlib-free; no `sorry`/`admit`/`axiom`/`native_decide`.
-/

import SphincsCVerify.Interpreter.C10HeadSource
import SphincsCVerify.Interpreter.C10HeadProgram

namespace SphincsCVerify.Interpreter.C10

open SphincsCVerify.Interpreter
open SphincsCVerify.Interpreter.YulParse

/-- Tokenizer + parser fuel for the optimized source (~32 kB; `parseFuel` = 16,384 is too
    small for its whitespace-and-token count). -/
def headFuel : Nat := 65536

set_option maxRecDepth 100000 in
/-- The optimized v1's assembly interior parses to exactly `c10HeadProgram`. -/
theorem parse_c10_head : parseYulFuel headFuel c10HeadSource = some c10HeadProgram := rfl

end SphincsCVerify.Interpreter.C10
