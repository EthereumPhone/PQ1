/-! ## 2. The reference's digit sum, as the same fold -/

/-- `partialDigitSum d n` (spec `readBitsLe` form) is the interpreter-form fold, for `n ≤ 43`. -/
theorem partialDigitSum_eq_fold (d_bv : ByteVec 32) :
    ∀ n, n ≤ 43 → partialDigitSum d_bv n
      = (List.range n).foldl (fun acc ii => acc + ((wordOf d_bv >>> (ii * 3)) &&& 7)) 0
  | 0, _ => by simp [partialDigitSum]
  | n + 1, hn => by
    rw [partialDigitSum_succ, partialDigitSum_eq_fold d_bv n (by omega), List.range_succ,
      List.foldl_append, List.foldl_cons, List.foldl_nil,
      digit_align d_bv n (by have : Spec.L = 43 := rfl; omega)]

/-! ## 3. The two fragments, pinned to the programs -/

/-- The reference's digit sum (`let digitSum := 0` + the 43-iteration loop). -/
def refDigitSumFrag : List Stmt :=
  [ .letv "digitSum" (.lit 0), .forRange "ii" (.lit 43) wotsDigitSumBody ]

/-- The optimized v1's digit sum (two `let`s). -/
def headDigitSumFrag : List Stmt :=
  [ .letv "lanes" (.bin .add (.bin .add (.bin .band (.var "d") (.lit 0x1c0e070381c0e070381c0e070381c0e07))
        (.bin .band (.bin .shr (.lit 3) (.var "d")) (.lit 0xe070381c0e070381c0e070381c0e07)))
        (.bin .band (.bin .shr (.lit 6) (.var "d")) (.lit 0xe070381c0e070381c0e070381c0e07)))
  , .letv "digitSum" (.bin .band (.bin .shr (.lit 126) (.bin .mul (.var "lanes")
        (.lit 0x40201008040201008040201008040201))) (.lit 511)) ]

/-- The body of a top-level `forRange` (empty otherwise). -/
def loopBody : Option Stmt → List Stmt
  | some (.forRange _ _ b) => b
  | _ => []

/-- `refDigitSumFrag` is statements 11-12 of the reference's layer loop (statement 28). -/
theorem ref_digitSum_pin : ((loopBody c10Program[28]?).drop 11).take 2 = refDigitSumFrag := rfl

/-- `headDigitSumFrag` is statements 11-12 of the optimized v1's layer loop (statement 28). -/
theorem head_digitSum_pin : ((loopBody c10HeadProgram[28]?).drop 11).take 2 = headDigitSumFrag := rfl

/-! ## 4. The relational theorem -/

/-- What the optimized v1's first statement binds (`lanes`), as the interpreter evaluates it. -/
def lanesVal (d : Nat) : Nat :=
  (((d &&& 0x1c0e070381c0e070381c0e070381c0e07) + ((d >>> 3) &&& 0xe070381c0e070381c0e070381c0e07)) % W
    + ((d >>> 6) &&& 0xe070381c0e070381c0e070381c0e07)) % W

/-- What its second statement binds (`digitSum`) from `lanes`. -/
def dsVal (l : Nat) : Nat := ((l * 0x40201008040201008040201008040201 % W) >>> 126) &&& 511

theorem execList_single {n : Nat} (sha : List UInt8 → ByteVec 32) (sig : ByteVec n) (s : Stmt) (vm : VM) :
    execList sha sig [s] vm = execStmt sha sig s vm := by
  rw [execList]
  cases execStmt sha sig s vm with
  | mk a b => cases b <;> simp only [execList]

/-- The reference loop leaves memory unchanged (its body only assigns `digitSum`). -/
theorem ref_loop_mem (sig : ByteVec Spec.SignatureLen) (vm : VM) :
    (execFor c10Oracle sig "ii" wotsDigitSumBody 43 0 vm).1.mem = vm.mem := by
  have h := execFor_invariant_lt c10Oracle sig "ii" wotsDigitSumBody 43 (fun _ w => w.mem = vm.mem)
    (by
      intro cur w _ hw
      refine ⟨?_, ?_⟩
      · unfold wotsDigitSumBody; rw [execList_single]; simp only [execStmt]
      · unfold wotsDigitSumBody; rw [execList_single]; simp only [execStmt]; exact hw)
    vm rfl
  exact h.2

/-- **E1, relational.** From two states that agree on `d` (the WOTS message digest word), the
    reference's digit-sum fragment and the optimized v1's both fall through, keep memory, bind
    the same `digitSum`, and change no variable but `digitSum` and their own scratch. -/
theorem e1_digitSum_rel (sig : ByteVec Spec.SignatureLen) (vmR vmH : VM) (d_bv : ByteVec 32)
    (hR : vmR.env "d" = wordOf d_bv) (hH : vmH.env "d" = wordOf d_bv) :
    (execList c10Oracle sig refDigitSumFrag vmR).2 = none
    ∧ (execList c10Oracle sig headDigitSumFrag vmH).2 = none
    ∧ (execList c10Oracle sig refDigitSumFrag vmR).1.env "digitSum"
        = (execList c10Oracle sig headDigitSumFrag vmH).1.env "digitSum"
    ∧ (execList c10Oracle sig refDigitSumFrag vmR).1.mem = vmR.mem
    ∧ (execList c10Oracle sig headDigitSumFrag vmH).1.mem = vmH.mem
    ∧ (∀ y, y ≠ "digitSum" → y ≠ "ii" →
        (execList c10Oracle sig refDigitSumFrag vmR).1.env y = vmR.env y)
    ∧ (∀ y, y ≠ "digitSum" → y ≠ "lanes" →
        (execList c10Oracle sig headDigitSumFrag vmH).1.env y = vmH.env y) := by
  -- the reference side
  let vm1 : VM := { vmR with env := setVar vmR.env "digitSum" 0 }
  have hR1 : execList c10Oracle sig refDigitSumFrag vmR
      = execFor c10Oracle sig "ii" wotsDigitSumBody 43 0 vm1 := by
    unfold refDigitSumFrag
    rw [execList_cons_none c10Oracle sig _ _ _ (by simp only [execStmt]), execList_single]
    simp only [execStmt, eval]; rfl
  have hd1 : vm1.env "d" = wordOf d_bv := by
    show setVar vmR.env "digitSum" 0 "d" = _
    rw [setVar_get_ne _ _ _ _ (by decide), hR]
  have hds1 : vm1.env "digitSum" = 0 := by
    show setVar vmR.env "digitSum" 0 "digitSum" = 0
    exact setVar_get_eq _ _ _
  obtain ⟨hnR, hvR, _⟩ := wots_digit_sum sig vm1 d_bv hd1 hds1
  -- the optimized side: two lets
  have hH2 : execList c10Oracle sig headDigitSumFrag vmH
      = ({ vmH with env := setVar (setVar vmH.env "lanes" (lanesVal (vmH.env "d"))) "digitSum" (dsVal (lanesVal (vmH.env "d"))) }, none) := by
    unfold headDigitSumFrag
    rw [execList_cons_none c10Oracle sig _ _ _ (by simp only [execStmt]), execList_single]
