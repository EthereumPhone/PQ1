/-- AND with a mask split at bit 9 splits the operand the same way. -/
theorem and_split (x a b : Nat) (ha : a < 2 ^ 9) :
    x &&& (2 ^ 9 * b + a) = 2 ^ 9 * (x / 2 ^ 9 &&& b) + (x % 2 ^ 9 &&& a) := by
  apply Nat.eq_of_testBit_eq
  intro i
  have hlt : (x % 2 ^ 9 &&& a) < 2 ^ 9 := Nat.and_lt_two_pow _ ha
  rw [Nat.testBit_and, Nat.testBit_two_pow_mul_add _ ha, Nat.testBit_two_pow_mul_add _ hlt]
  by_cases hi : i < 9
  · simp only [hi, if_true, Nat.testBit_and, Nat.testBit_mod_two_pow, decide_true, Bool.true_and]
  · simp only [hi, if_false, Nat.testBit_and, Nat.testBit_div_two_pow]
    have : i - 9 + 9 = i := by omega
    rw [this]

/-- The mask with `7` in the low 3 bits of each of `n` 9-bit lanes. -/
def m7 : Nat → Nat
  | 0 => 0
  | n + 1 => 2 ^ 9 * m7 n + 7

/-- The low 3 bits of each of the first `n` 9-bit lanes of `x`, in place. -/
def laneLow : Nat → Nat → Nat
  | 0, _ => 0
  | n + 1, x => 2 ^ 9 * laneLow n (x / 2 ^ 9) + x % 8

theorem and_m7 : ∀ n x, x &&& m7 n = laneLow n x
  | 0, x => by simp [m7, laneLow]
  | n + 1, x => by
    rw [m7, laneLow, and_split x 7 (m7 n) (by decide), and_m7 n (x / 2 ^ 9)]
    congr 1
    have h7 : (7 : Nat) = 2 ^ 3 - 1 := rfl
    rw [h7, Nat.and_two_pow_sub_one_eq_mod, Nat.mod_mod_of_dvd _ (by decide)]

theorem m7_15 : m7 15 = 0x1c0e070381c0e070381c0e070381c0e07 := by decide
theorem m7_14 : m7 14 = 0xe070381c0e070381c0e070381c0e07 := by decide

theorem and7 (y : Nat) : y &&& 7 = y % 8 := by
  rw [show (7 : Nat) = 2 ^ 3 - 1 by rfl, Nat.and_two_pow_sub_one_eq_mod]

theorem and1FF (y : Nat) : y &&& 511 = y % 512 := by
  rw [show (511 : Nat) = 2 ^ 9 - 1 by rfl, Nat.and_two_pow_sub_one_eq_mod]

/-- `laneLow n x` fits in `n` lanes. -/
theorem laneLow_lt : ∀ n x, laneLow n x < 2 ^ (9 * n)
  | 0, _ => by simp [laneLow]
  | n + 1, x => by
    have ih := laneLow_lt n (x / 2 ^ 9)
    have h8 : x % 8 < 8 := Nat.mod_lt _ (by decide)
    rw [laneLow, show 9 * (n + 1) = 9 * n + 9 by omega, Nat.pow_add]
    generalize laneLow n (x / 2 ^ 9) = L at *
    generalize (2:Nat) ^ (9 * n) = A at *
    have : (2:Nat) ^ 9 = 512 := rfl
    rw [this]
    omega

