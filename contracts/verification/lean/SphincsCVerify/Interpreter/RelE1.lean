        % 2 ^ 256 + ((x >>> 6) &&& 0xe070381c0e070381c0e070381c0e07)) % 2 ^ 256
        * 0x40201008040201008040201008040201 % 2 ^ 256) >>> 126) &&& 511
      = (List.range 43).foldl (fun acc ii => acc + ((x >>> (ii * 3)) &&& 7)) 0 := by
