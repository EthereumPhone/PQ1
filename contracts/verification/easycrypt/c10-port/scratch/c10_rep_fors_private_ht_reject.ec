(* Actual EasyCrypt digest fields and complete wire decoder refine the common
   generated integer/list forms. The paired Lean proofs cover the extracted
   readers and actual parser values. No full-session/probability transfer or
   cross-kernel certificate is claimed. *)
require import AllCore List IntDiv Ring BitEncoding.
require import C10Bytes RawForest RawWots RawSignature.
(* Generated by easycrypt/c10-port/tools/c10_representation.py. Do not edit. Counts range over nonnegative integers; words are signed integers. *)

require import AllCore List IntDiv.

op byte_word_le (bs : (int list)) : int =
  (foldr (fun b acc => (b + (256 * acc))) 0 bs).

op byte_word (bs : (int list)) : int =
  (byte_word_le (rev bs)).

op word_window (bs : (int list)) (off : int) (width : int) : int =
  (((byte_word bs) %/ (2 ^ off)) %% (2 ^ width)).

op ht_field (bs : (int list)) : int =
  (word_window bs 143 18).

op fors_field (bs : (int list)) (t : int) : int =
  (word_window bs (11 * t) 11).

op wots_field (bs : (int list)) (i : int) : int =
  (word_window bs (3 * i) 3).

op wots_sum (bs : (int list)) : int =
  (foldr (fun b acc => (b + acc)) 0 (mkseq (fun i => (wots_field bs i)) 43)).

op wots_target  : int =
  205.

op fors_zero_field (bs : (int list)) : int =
  (word_window bs 132 11).

op word_nodes (n : int) (bs : (int list)) (off : int) : ((int list) list) =
  (mkseq (fun i => (take 16 (drop (off + (16 * i)) bs))) n).

op word_layer (bs : (int list)) (off : int) : (((int list) list) * int * ((int list) list)) =
  ((word_nodes 43 bs off), (byte_word (take 4 (drop (off + 688) bs))), (word_nodes 9 bs (off + 692))).

op word_decode (bs : (int list)) : ((int list) * ((int list) list) * (((int list) list) list) * ((((int list) list) * int * ((int list) list)) list)) =
  ((take 16 bs), (word_nodes 13 bs 16), (mkseq (fun t => (word_nodes 11 bs (224 + (176 * t)))) 12), (mkseq (fun l => (word_layer bs (2336 + (836 * l)))) 2)).

op pad_node (value : (int list)) : (int list) =
  (value ++ (nseq 16 0)).

op u32_bytes (nonce : int) : (int list) =
  (rev (mkseq (fun i => ((nonce %/ (2 ^ (8 * i))) %% 256)) 4)).

op hmsg_preimage (seed : (int list)) (root : (int list)) (random : (int list)) (message : (int list)) : (int list) =
  (seed ++ root ++ random ++ message ++ (nseq 32 255)).

op th_preimage (seed : (int list)) (address : (int list)) (value : (int list)) : (int list) =
  (seed ++ address ++ value).

op pair_preimage (seed : (int list)) (address : (int list)) (left : (int list)) (right : (int list)) : (int list) =
  (seed ++ address ++ left ++ right).

op multi_preimage (seed : (int list)) (address : (int list)) (values : ((int list) list)) : (int list) =
  (seed ++ address ++ (foldr (fun value tail => ((pad_node value) ++ tail)) [] values)).

op wots_preimage (seed : (int list)) (address : (int list)) (message : (int list)) (nonce : int) : (int list) =
  (seed ++ address ++ message ++ (nseq 28 0) ++ (u32_bytes nonce)).

op r_preimage (secret : (int list)) (random : (int list)) (message : (int list)) (nonce : int) : (int list) =
  (secret ++ [82; 95; 103; 114; 105; 110; 100] ++ random ++ message ++ (nseq 28 0) ++ (u32_bytes nonce)).

op u64_bytes (nonce : int) : (int list) =
  (rev (mkseq (fun i => ((nonce %/ (2 ^ (8 * i))) %% 256)) 8)).

op address_words (layer : int) (tree : int) (kind : int) (kp : int) (ci : int) (cp : int) (ha : int) : (int list) =
  ((u32_bytes layer) ++ (u64_bytes tree) ++ (u32_bytes kind) ++ (u32_bytes kp) ++ (u32_bytes ci) ++ (u32_bytes cp) ++ (u32_bytes ha)).

op chain_index_words (address : (int list)) (ci : int) : (int list) =
  ((take 20 address) ++ (u32_bytes ci) ++ (drop 24 address)).

op chain_position_words (address : (int list)) (cp : int) : (int list) =
  ((take 24 address) ++ (u32_bytes cp) ++ (drop 28 address)).

op wots_private_preimage (secret : (int list)) (layer : int) (tree : int) (kp : int) (ci : int) : (int list) =
  (secret ++ [119; 111; 116; 115] ++ (u32_bytes layer) ++ (nseq 24 0) ++ (u64_bytes tree) ++ (u32_bytes kp) ++ (u32_bytes ci)).

op fors_private_preimage (secret : (int list)) (ht : int) (tree : int) (leaf : int) : (int list) =
  (secret ++ [102; 111; 114; 115] ++ (u32_bytes tree) ++ (u32_bytes tree) ++ (u32_bytes leaf)).

op shuffle_forest_label  : (int list) =
  [102; 111; 114; 115].

op shuffle_layer_label (layer : int) : (int list) =
  (if layer = 0 then [119; 111; 116; 115; 45; 48; 0] else [119; 111; 116; 115; 45; 49; 0]).

op shuffle_seed_preimage (seed : (int list)) (label : (int list)) : (int list) =
  ([115; 112; 104; 105; 110; 99; 115; 45; 99; 49; 48; 45; 115; 104; 117; 102; 102; 108; 101; 45; 118; 49] ++ seed ++ label).

op shuffle_block_preimage (seed : (int list)) (nonce : int) : (int list) =
  ([115; 112; 104; 105; 110; 99; 115; 45; 99; 49; 48; 45; 102; 105; 115; 104; 101; 114; 45; 121; 97; 116; 101; 115; 45; 118; 49] ++ seed ++ (u32_bytes nonce)).

op shuffle_choice (lo : int) (hi : int) (bound : int) : int =
  ((((hi * 256) + lo) * bound) %/ 65536).

op shuffle_swap (order : (int list)) (i : int) (j : int) : (int list) =
  (put (put order i (nth 0 order j)) j (nth 0 order i)).

op shuffle_order (n : int) (stream : (int list)) : (int list) =
  (foldr (fun i order => (shuffle_swap order i (shuffle_choice (nth 0 stream (2 * (max 0 ((max 0 (n - 1)) - i)))) (nth 0 stream ((2 * (max 0 ((max 0 (n - 1)) - i))) + 1)) (i + 1)))) (mkseq (fun i => i) n) (mkseq (fun i => (i + 1)) (max 0 (n - 1)))).

op wots_first_slot (digests : ((int list) list)) : int =
  (foldr (fun digest slot => (if ((wots_sum digest) - (wots_target )) = 0 then 1 else (if slot = 0 then 0 else (slot + 1)))) 0 digests).

op fors_first_slot (digests : ((int list) list)) : int =
  (foldr (fun digest slot => (if (fors_zero_field digest) = 0 then 1 else (if slot = 0 then 0 else (slot + 1)))) 0 digests).

op hash_bytes_node (hash_fn : (int list -> int list)) (bs : (int list)) : (int list) =
  (take 16 (hash_fn bs)).

op wots_secret_value (hash_fn : (int list -> int list)) (secret : (int list)) (layer : int) (tree : int) (kp : int) (ci : int) : (int list) =
  (hash_bytes_node hash_fn (wots_private_preimage secret layer tree kp ci)).

op wots_chain_value (hash_fn : (int list -> int list)) (seed : (int list)) (address : (int list)) (value : (int list)) (start : int) (steps : int) : (int list) =
  (foldr (fun i current => (hash_bytes_node hash_fn (th_preimage seed (chain_position_words address (start + (i))) (pad_node current)))) value (rev (mkseq (fun i => i) steps))).

op wots_keygen_nodes (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (layer : int) (tree : int) (kp : int) : ((int list) list) =
  (mkseq (fun i => (wots_chain_value hash_fn seed (address_words layer tree 0 kp (i) 0 0) (wots_secret_value hash_fn secret layer tree kp (i)) 0 7)) 43).

op wots_keygen_value (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (layer : int) (tree : int) (kp : int) : (int list) =
  (hash_bytes_node hash_fn (multi_preimage seed (address_words layer tree 1 kp 0 0 0) (wots_keygen_nodes hash_fn seed secret layer tree kp))).

op wots_sign_values (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (layer : int) (tree : int) (kp : int) (bs : (int list)) : ((int list) list) =
  (mkseq (fun i => (wots_chain_value hash_fn seed (address_words layer tree 0 kp (i) 0 0) (wots_secret_value hash_fn secret layer tree kp (i)) 0 (max 0 (wots_field bs i)))) 43).

op wots_recover_nodes (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kp : int) (bs : (int list)) (values : ((int list) list)) : ((int list) list) =
  (mkseq (fun i => (wots_chain_value hash_fn seed (address_words layer tree 0 kp (i) 0 0) (nth (nseq 16 0) values i) (wots_field bs i) (max 0 (7 - (wots_field bs i))))) 43).

op wots_recover_value (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kp : int) (message : (int list)) (values : ((int list) list)) (nonce : int) : (int list) =
  (if ((wots_sum (hash_fn (wots_preimage seed (address_words layer tree 0 kp 0 0 0) (pad_node message) nonce))) - (wots_target )) = 0 then (hash_bytes_node hash_fn (multi_preimage seed (address_words layer tree 1 kp 0 0 0) (wots_recover_nodes hash_fn seed layer tree kp (hash_fn (wots_preimage seed (address_words layer tree 0 kp 0 0 0) (pad_node message) nonce)) values))) else (nseq 16 0)).

op fors_secret_value (hash_fn : (int list -> int list)) (secret : (int list)) (ht : int) (tree : int) (leaf : int) : (int list) =
  (hash_bytes_node hash_fn (fors_private_preimage secret ht tree leaf)).

op fors_leaf_value (hash_fn : (int list -> int list)) (seed : (int list)) (ht : int) (tree : int) (leaf : int) (value : (int list)) : (int list) =
  (hash_bytes_node hash_fn (th_preimage seed (address_words 0 ht 3 tree 0 0 leaf) (pad_node value))).

op tree_pair_value (hash_fn : (int list -> int list)) (seed : (int list)) (address : (int list)) (left : (int list)) (right : (int list)) : (int list) =
  (hash_bytes_node hash_fn (pair_preimage seed address (pad_node left) (pad_node right))).

op tree_path_step (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kind : int) (kp : int) (auth : ((int list) list)) (index0 : int) (current : (int list)) (height : int) : (int list) =
  (tree_pair_value hash_fn seed (address_words layer tree kind kp 0 ((height + 1)) ((index0 %/ (2 ^ height)) %/ 2)) (if ((index0 %/ (2 ^ height)) %% 2) = 0 then current else (nth (nseq 16 0) auth height)) (if ((index0 %/ (2 ^ height)) %% 2) = 0 then (nth (nseq 16 0) auth height) else current)).

op tree_path_value (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kind : int) (kp : int) (value : (int list)) (index0 : int) (auth : ((int list) list)) (steps : int) : (int list) =
  (foldr (fun i current => (tree_path_step hash_fn seed layer tree kind kp auth index0 current i)) value (rev (mkseq (fun i => i) steps))).

op fors_recover_value (hash_fn : (int list -> int list)) (seed : (int list)) (ht : int) (tree : int) (leaf : int) (value : (int list)) (auth : ((int list) list)) : (int list) =
  (tree_path_value hash_fn seed 0 ht 3 tree (fors_leaf_value hash_fn seed ht tree leaf value) leaf auth 11).

op merkle_recover_value (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (value : (int list)) (index0 : int) (auth : ((int list) list)) : (int list) =
  (tree_path_value hash_fn seed layer tree 2 0 value index0 auth 9).

op tree_level_value (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kind : int) (kp : int) (total_height : int) (height : int) (nodes : ((int list) list)) : ((int list) list) =
  (mkseq (fun i => (tree_pair_value hash_fn seed (address_words layer tree kind kp 0 (height) (i)) (nth (nseq 16 0) nodes (2 * i)) (nth (nseq 16 0) nodes ((2 * i) + 1)))) (2 ^ (max 0 (total_height - height)))).

op tree_nodes_value (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kind : int) (kp : int) (total_height : int) (rounds : int) (values : ((int list) list)) : ((int list) list) =
  (foldr (fun i nodes => (tree_level_value hash_fn seed layer tree kind kp total_height (i + 1) nodes)) values (rev (mkseq (fun i => i) rounds))).

op tree_root_value (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kind : int) (kp : int) (total_height : int) (values : ((int list) list)) : (int list) =
  (nth (nseq 16 0) (tree_nodes_value hash_fn seed layer tree kind kp total_height total_height values) 0).

op tree_auth_values (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kind : int) (kp : int) (total_height : int) (values : ((int list) list)) (index0 : int) : ((int list) list) =
  (mkseq (fun height => (nth (nseq 16 0) (tree_nodes_value hash_fn seed layer tree kind kp total_height height values) (max 0 (if ((index0 %/ (2 ^ height)) %% 2) = 0 then ((index0 %/ (2 ^ height)) + 1) else ((index0 %/ (2 ^ height)) - 1))))) total_height).

op fors_tree_leaves (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (ht : int) (tree : int) : ((int list) list) =
  (mkseq (fun i => (fors_leaf_value hash_fn seed ht tree (i) (fors_secret_value hash_fn secret ht tree (i)))) 2048).

op fors_root_value (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (ht : int) (tree : int) : (int list) =
  (tree_root_value hash_fn seed 0 ht 3 tree 11 (fors_tree_leaves hash_fn seed secret ht tree)).

op fors_auth_values (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (ht : int) (tree : int) (leaf : int) : ((int list) list) =
  (tree_auth_values hash_fn seed 0 ht 3 tree 11 (fors_tree_leaves hash_fn seed secret ht tree) leaf).

op fors_sign_values (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (ht : int) (tree : int) (leaf : int) : ((int list) * ((int list) list)) =
  ((fors_secret_value hash_fn secret ht tree leaf), (fors_auth_values hash_fn seed secret ht tree leaf)).

op merkle_tree_leaves (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (layer : int) (tree : int) : ((int list) list) =
  (mkseq (fun i => (wots_keygen_value hash_fn seed secret layer tree (i))) 512).

op merkle_root_value (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (layer : int) (tree : int) : (int list) =
  (tree_root_value hash_fn seed layer tree 2 0 9 (merkle_tree_leaves hash_fn seed secret layer tree)).

op merkle_auth_values (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (layer : int) (tree : int) (index0 : int) : ((int list) list) =
  (tree_auth_values hash_fn seed layer tree 2 0 9 (merkle_tree_leaves hash_fn seed secret layer tree) index0).

op merkle_build_value (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (layer : int) (tree : int) (index0 : int) : (((int list) list) * (int list)) =
  ((merkle_auth_values hash_fn seed secret layer tree index0), (merkle_root_value hash_fn seed secret layer tree)).

op forest_sign_secrets (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (ht : int) (forest_indices : (int list)) : ((int list) list) =
  ((mkseq (fun i => (fors_secret_value hash_fn secret ht (i) (nth 0 forest_indices i))) 12) ++ [(fors_root_value hash_fn seed secret ht 12)]).

op forest_sign_paths (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (ht : int) (forest_indices : (int list)) : (((int list) list) list) =
  (mkseq (fun i => (fors_auth_values hash_fn seed secret ht (i) (nth 0 forest_indices i))) 12).

op forest_recover_roots (hash_fn : (int list -> int list)) (seed : (int list)) (ht : int) (forest_indices : (int list)) (forest_secrets : ((int list) list)) (forest_paths : (((int list) list) list)) : ((int list) list) =
  ((mkseq (fun i => (fors_recover_value hash_fn seed ht (i) (nth 0 forest_indices i) (nth (nseq 16 0) forest_secrets i) (nth [] forest_paths i))) 12) ++ [(fors_leaf_value hash_fn seed ht 12 0 (nth (nseq 16 0) forest_secrets 12))]).

op forest_compress_value (hash_fn : (int list -> int list)) (seed : (int list)) (ht : int) (values : ((int list) list)) : (int list) =
  (hash_bytes_node hash_fn (multi_preimage seed (address_words 0 ht 4 0 0 0 0) values)).

op forest_recover_value (hash_fn : (int list -> int list)) (seed : (int list)) (ht : int) (forest_indices : (int list)) (forest_secrets : ((int list) list)) (forest_paths : (((int list) list) list)) : (int list) =
  (forest_compress_value hash_fn seed ht (forest_recover_roots hash_fn seed ht forest_indices forest_secrets forest_paths)).

op forest_sign_value (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (ht : int) (forest_indices : (int list)) : (((int list) list) * (((int list) list) list) * (int list)) =
  ((forest_sign_secrets hash_fn seed secret ht forest_indices), (forest_sign_paths hash_fn seed secret ht forest_indices), (forest_recover_value hash_fn seed ht forest_indices (forest_sign_secrets hash_fn seed secret ht forest_indices) (forest_sign_paths hash_fn seed secret ht forest_indices))).

op wots_search_digests (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kp : int) (message : (int list)) : ((int list) list) =
  (mkseq (fun i => (hash_fn (wots_preimage seed (address_words layer tree 0 kp 0 0 0) (pad_node message) (i)))) 10000000).

op layer_sign_slot (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kp : int) (message : (int list)) : int =
  (wots_first_slot (wots_search_digests hash_fn seed layer tree kp message)).

op layer_sign_values (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (layer : int) (tree : int) (kp : int) (message : (int list)) (nonce : int) : (((int list) list) * int * ((int list) list)) =
  ((wots_sign_values hash_fn seed secret layer tree kp (hash_fn (wots_preimage seed (address_words layer tree 0 kp 0 0 0) (pad_node message) nonce))), nonce, (merkle_auth_values hash_fn seed secret layer tree kp)).

op layer_recover_value (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kp : int) (message : (int list)) (values : ((int list) list)) (nonce : int) (auth : ((int list) list)) : (int list) =
  (merkle_recover_value hash_fn seed layer tree (wots_recover_value hash_fn seed layer tree kp message values nonce) kp auth).

op digest_fors_indices (bs : (int list)) : (int list) =
  (mkseq (fun i => (fors_field bs i)) 13).

op verifier_digest (hash_fn : (int list -> int list)) (seed : (int list)) (root : (int list)) (random : (int list)) (message : (int list)) : (int list) =
  (hash_fn (hmsg_preimage seed root (pad_node random) message)).

op digest_forest_value (hash_fn : (int list -> int list)) (seed : (int list)) (bs : (int list)) (forest_secrets : ((int list) list)) (forest_paths : (((int list) list) list)) : (int list) =
  (forest_recover_value hash_fn seed (ht_field bs) (digest_fors_indices bs) forest_secrets forest_paths).

op hypertree_first_value (hash_fn : (int list -> int list)) (seed : (int list)) (ht : int) (message : (int list)) (values : ((int list) list)) (nonce : int) (auth : ((int list) list)) : (int list) =
  (layer_recover_value hash_fn seed 0 (ht %/ 512) (ht %% 512) message values nonce auth).

op hypertree_recover_value (hash_fn : (int list -> int list)) (seed : (int list)) (ht : int) (message : (int list)) (values0 : ((int list) list)) (nonce0 : int) (auth0 : ((int list) list)) (values1 : ((int list) list)) (nonce1 : int) (auth1 : ((int list) list)) : (int list) =
  (layer_recover_value hash_fn seed 1 ((ht %/ 512) %/ 512) ((ht %/ 512) %% 512) (hypertree_first_value hash_fn seed ht message values0 nonce0 auth0) values1 nonce1 auth1).

op verifier_recover_value (hash_fn : (int list -> int list)) (seed : (int list)) (bs : (int list)) (forest_secrets : ((int list) list)) (forest_paths : (((int list) list) list)) (values0 : ((int list) list)) (nonce0 : int) (auth0 : ((int list) list)) (values1 : ((int list) list)) (nonce1 : int) (auth1 : ((int list) list)) : (int list) =
  (hypertree_recover_value hash_fn seed (ht_field bs) (digest_forest_value hash_fn seed bs forest_secrets forest_paths) values0 nonce0 auth0 values1 nonce1 auth1).

op signer_randomizer (hash_fn : (int list -> int list)) (secret : (int list)) (random : (int list)) (message : (int list)) (nonce : int) : (int list) =
  (hash_bytes_node hash_fn (r_preimage secret random message nonce)).

op signer_digest (hash_fn : (int list -> int list)) (seed : (int list)) (root : (int list)) (secret : (int list)) (random : (int list)) (message : (int list)) (nonce : int) : (int list) =
  (verifier_digest hash_fn seed root (signer_randomizer hash_fn secret random message nonce) message).

op signer_search_digests (hash_fn : (int list -> int list)) (seed : (int list)) (root : (int list)) (secret : (int list)) (random : (int list)) (message : (int list)) : ((int list) list) =
  (mkseq (fun i => (signer_digest hash_fn seed root secret random message (i))) 10000000).

op signer_nonce_slot (hash_fn : (int list -> int list)) (seed : (int list)) (root : (int list)) (secret : (int list)) (random : (int list)) (message : (int list)) : int =
  (fors_first_slot (signer_search_digests hash_fn seed root secret random message)).

op nodes_bytes (values : ((int list) list)) : (int list) =
  (foldr (fun value tail => (value ++ tail)) [] values).

op layer_bytes (values : ((int list) list)) (nonce : int) (auth : ((int list) list)) : (int list) =
  ((nodes_bytes values) ++ (u32_bytes nonce) ++ (nodes_bytes auth)).

op signature_bytes (random : (int list)) (forest_secrets : ((int list) list)) (forest_paths : (((int list) list) list)) (values0 : ((int list) list)) (nonce0 : int) (auth0 : ((int list) list)) (values1 : ((int list) list)) (nonce1 : int) (auth1 : ((int list) list)) : (int list) =
  (random ++ (nodes_bytes forest_secrets) ++ (foldr (fun path_row tail => ((nodes_bytes path_row) ++ tail)) [] forest_paths) ++ (layer_bytes values0 nonce0 auth0) ++ (layer_bytes values1 nonce1 auth1)).

import BS2Int.

lemma byte_word_le_value bs :
  all (fun b => 0 <= b < 256) bs =>
  bs2int (flatten (map (int2bs 8) bs)) = byte_word_le bs.
proof.
  rewrite /byte_word_le.
  elim: bs => [|b bs ih] /=.
  + by rewrite bs2int_nil.
  move=> [hb hbs].
  have hp : 2^8=256 by rewrite (_:8=2*2*2) 1:// !IntID.exprM !IntID.expr2.
  rewrite flatten_cons bs2int_cat size_int2bs /= (int2bsK 8 b) 1:// 1:/#.
  by rewrite (ih hbs) hp.
qed.

lemma byte_word_value bs :
  all (fun b => 0 <= b < 256) bs =>
  bs2int (bytes_to_bits bs) = byte_word bs.
proof.
  move=> hb; rewrite /bytes_to_bits /byte_word byte_word_le_value // all_rev.
  exact hb.
qed.

lemma byte_window bs off width :
  0 <= off => 0 <= width => all (fun b => 0 <= b < 256) bs =>
  bs2int (take width (drop off (bytes_to_bits bs))) =
    (byte_word bs %/ 2^off) %% 2^width.
proof.
  move=> ho hw hb.
  by rewrite -bs2int_mod // -bs2int_div // byte_word_value.
qed.

lemma hypertree_field_bytes bs :
  all (fun b => 0 <= b < 256) bs =>
  hypertree_index (bytes_to_bits bs) = (byte_word bs %/ 2^143) %% 2^18.
proof. by move=> hb; rewrite /hypertree_index byte_window. qed.

lemma forest_field_bytes bs t :
  0 <= t => all (fun b => 0 <= b < 256) bs =>
  forest_index (bytes_to_bits bs) t = (byte_word bs %/ 2^(11*t)) %% 2^11.
proof. move=> ht hb; rewrite /forest_index byte_window //; smt(). qed.

lemma wots_field_bytes bs j :
  size bs = 32 => 0 <= j < 43 => all (fun b => 0 <= b < 256) bs =>
  RadixEncoding.digit 3 (bytes_to_bits bs) j = (byte_word bs %/ 2^(3*j)) %% 8.
proof.
  move=> hs hj hb.
  rewrite RadixEncoding.digit_integer 1,2:/# 1:bytes_to_bits_size 1:hs 1:/#.
  have hp : 2^3=8 by rewrite (_:3=2+1) 1:// IntID.exprS 1:// IntID.expr2.
  by rewrite byte_word_value // hp.
qed.

lemma byte_window_valid bs off width :
  all (fun b => 0 <= b < 256) bs =>
  all (fun b => 0 <= b < 256) (take width (drop off bs)).
proof. smt(allP mem_take mem_drop). qed.

lemma read_layer_word bs offset :
  all (fun b => 0 <= b < 256) bs => read_layer bs offset = word_layer bs offset.
proof.
  move=> hb; rewrite /read_layer /word_layer /word_nodes /read_nodes /read_node byte_word_value //.
  exact (byte_window_valid bs (offset+688) 4 hb).
qed.

lemma decode_word bs :
  all (fun b => 0 <= b < 256) bs => decode_signature bs = word_decode bs.
proof.
  move=> hb; rewrite /decode_signature /word_decode.
  have hn : forall n b o, read_nodes n b o = word_nodes n b o by rewrite /read_nodes /read_node /word_nodes.
  rewrite !hn.
  congr.
  + by apply eq_in_mkseq => t ht; rewrite /read_nodes /read_node /word_nodes.
  apply eq_in_mkseq => l hl; exact (read_layer_word bs _ hb).
qed.

lemma hypertree_common bs :
  all (fun b => 0 <= b < 256) bs =>
  hypertree_index (bytes_to_bits bs) = ht_field bs.
proof. by move=> hb; rewrite /ht_field /word_window hypertree_field_bytes. qed.

lemma forest_common bs t :
  0 <= t => all (fun b => 0 <= b < 256) bs =>
  forest_index (bytes_to_bits bs) t = fors_field bs t.
proof. by move=> ht hb; rewrite /fors_field /word_window forest_field_bytes. qed.

lemma wots_common bs j :
  size bs = 32 => 0 <= j < 43 => all (fun b => 0 <= b < 256) bs =>
  RadixEncoding.digit 3 (bytes_to_bits bs) j = wots_field bs j.
proof.
  move=> hs hj hb; rewrite /wots_field /word_window wots_field_bytes //.
  have hp : 2^3=8 by rewrite (_:3=2+1) 1:// IntID.exprS 1:// IntID.expr2.
  by rewrite hp.
qed.

(* Paired preimage endpoints. These are byte-layout equalities, not a SHA
   idealization, hash-injectivity premise, or stateful caller simulation. *)
require import AllCore List IntDiv Ring BitEncoding.
require import C10Bytes C10Counter C10HashDomains RawKeygen.

import BS2Int BitChunking.

lemma counter_common (c : counter) : counter_bytes c = u32_bytes (U32.val c).
proof.
  have hp8 : 2^8 = 256 by rewrite (_ : 8=2*2*2) 1:// !IntID.exprM !IntID.expr2.
  have hp32 : 2^32 = 4294967296
    by rewrite (_ : 32=2*2*2*2*2) 1:// !IntID.exprM !IntID.expr2.
  have hc : 0 <= U32.val c < 2^32 by rewrite hp32 U32.valP.
  rewrite /counter_bytes /counter_bits /bits_to_bytes /chunk /u32_bytes
    size_int2bs /= map_mkseq.
  congr; apply eq_in_mkseq => i hi.
  rewrite /(\o) /=.
  by rewrite -bs2int_mod 1:// -bs2int_div 1:/# int2bsK 1:// 1:hc hp8.
qed.

lemma zero_word_bytes : bits_to_bytes (nseq 224 false) = nseq 28 0.
proof.
  rewrite /bits_to_bytes /chunk size_nseq /= map_mkseq.
  have hz : mkseq (bs2int \o fun i => take 8 (drop (8*i) (nseq 224 false))) 28 = nseq 28 0.
  + rewrite -(mkseq_nseq 28 0); apply eq_in_mkseq => i hi.
    by rewrite /(\o) /= -bs2int_mod 1:// -bs2int_div 1:/# bs2int_nseq_false.
  by rewrite hz rev_nseq.
qed.

lemma full_counter_word (c : counter) :
  be 32 (U32.val c) = nseq 28 0 ++ u32_bytes (U32.val c).
proof.
  have hp32 : 2^32 = 4294967296
    by rewrite (_ : 32=2*2*2*2*2) 1:// !IntID.exprM !IntID.expr2.
  have hz : U32.val c %/ 2^32 = 0 by rewrite hp32 divz_small 1:U32.valP.
  rewrite -counter_common /be (int2bs_cat 32 256) 1:// hz int2bs0 /=.
  rewrite /bits_to_bytes chunk_cat 1:size_int2bs 1:// map_cat rev_cat.
  have hzero := zero_word_bytes; rewrite /bits_to_bytes in hzero.
  rewrite hzero.
  by rewrite /counter_bytes /counter_bits.
qed.

lemma pad_common v : pad v = pad_node v.
proof. by rewrite /pad /pad_node. qed.

lemma hmsg_input_common seed root random message :
  hmsg_input seed root random message = hmsg_preimage seed root random message.
proof. by rewrite /hmsg_input /hmsg_preimage. qed.

lemma th_input_common seed address value :
  seed ++ address ++ value = th_preimage seed address value.
proof. by rewrite /th_preimage. qed.

lemma pair_input_common seed address lhs rhs :
  pair_input seed address lhs rhs = pair_preimage seed address lhs rhs.
proof. by rewrite /pair_input /pair_preimage. qed.

lemma padded_nodes_common vs :
  flatten (map pad vs) = foldr (fun v tail => pad_node v ++ tail) [] vs.
proof.
  elim: vs => [|v vs ih] /=; first by rewrite flatten_nil.
  by rewrite flatten_cons /= ih /pad /pad_node.
qed.

lemma multi_input_common seed address vs :
  seed ++ address ++ flatten (map pad vs) = multi_preimage seed address vs.
proof. by rewrite /multi_preimage padded_nodes_common. qed.

lemma wots_input_common seed address message c :
  seed ++ address ++ message ++ nseq 28 0 ++ counter_bytes c =
    wots_preimage seed address message (U32.val c).
proof. by rewrite /wots_preimage counter_common. qed.

lemma wots_payload_common seed address node c :
  transcript seed address node c =
    wots_preimage seed address (pad_node (bits_to_bytes node)) (U32.val c).
proof. by rewrite /transcript /payload /wots_preimage /pad_node counter_common !catA. qed.

lemma randomizer_input_common secret random message c :
  r_input secret random message c = r_preimage secret random message (U32.val c).
proof. by rewrite /r_input /r_preimage counter_common. qed.

(* RawWots.count/recover use the complete 32-byte count slot, rather than
   the compact four-byte signature field. This equality covers every u32. *)
lemma raw_wots_input_common seed address message c :
  seed ++ address ++ pad message ++ be 32 (U32.val c) =
    wots_preimage seed address (pad_node message) (U32.val c).
proof. by rewrite /wots_preimage pad_common full_counter_word !catA. qed.

lemma role_randomizer_input_common secret random message c :
  secret ++ RoleGrind.r_tail random message c =
    r_preimage secret random message (U32.val c).
proof. by rewrite -RoleGrind.r_tail_layout randomizer_input_common. qed.

(* Paired full-width address/private-input layouts. These equalities neither
   identify concrete SHA with an ideal oracle nor prove caller simulation. *)
require import AllCore List IntDiv Ring BitEncoding.
require import C10Bytes RawKeygen RawFors KeygenPrefixes RawSignature.

import BS2Int BitChunking.

lemma be4_common x : 0 <= x < 2^32 => be 4 x = u32_bytes x.
proof.
  move=> hx.
  have hp8 : 2^8 = 256 by rewrite (_ : 8=2*2*2) 1:// !IntID.exprM !IntID.expr2.
  rewrite /be /bits_to_bytes /chunk /u32_bytes size_int2bs /= map_mkseq.
  congr; apply eq_in_mkseq => i hi.
  rewrite /(\o) /=.
  by rewrite -bs2int_mod 1:// -bs2int_div 1:/# int2bsK 1:// 1:hx hp8.
qed.

lemma be8_common x : 0 <= x < 2^64 => be 8 x = u64_bytes x.
proof.
  move=> hx.
  have hp8 : 2^8 = 256 by rewrite (_ : 8=2*2*2) 1:// !IntID.exprM !IntID.expr2.
  rewrite /be /bits_to_bytes /chunk /u64_bytes size_int2bs /= map_mkseq.
  congr; apply eq_in_mkseq => i hi.
  rewrite /(\o) /=.
  by rewrite -bs2int_mod 1:// -bs2int_div 1:/# int2bsK 1:// 1:hx hp8.
qed.

lemma zero_tree_bytes : bits_to_bytes (nseq 192 false) = nseq 24 0.
proof.
  rewrite /bits_to_bytes /chunk size_nseq /= map_mkseq.
  have hz : mkseq (bs2int \o fun i => take 8 (drop (8*i) (nseq 192 false))) 24 = nseq 24 0.
  + rewrite -(mkseq_nseq 24 0); apply eq_in_mkseq => i hi.
    by rewrite /(\o) /= -bs2int_mod 1:// -bs2int_div 1:/# bs2int_nseq_false.
  by rewrite hz rev_nseq.
qed.

lemma padded_tree_common tree : 0 <= tree < 2^64 =>
  be 32 tree = nseq 24 0 ++ u64_bytes tree.
proof.
  move=> ht.
  have hp64 : 2^64 = 18446744073709551616
    by rewrite (_ : 64=2*2*2*2*2*2) 1:// !IntID.exprM !IntID.expr2.
  have hz : tree %/ 2^64 = 0 by rewrite hp64 divz_small 1:/#.
  rewrite /be (int2bs_cat 64 256) 1:// hz.
  rewrite int2bs0 /=.
  rewrite /bits_to_bytes chunk_cat 1:size_int2bs 1:// map_cat rev_cat.
  have hzero := zero_tree_bytes; rewrite /bits_to_bytes in hzero.
  rewrite hzero.
  have hb := be8_common tree ht; rewrite /be /bits_to_bytes in hb.
  by rewrite hb.
qed.

lemma address_common layer tree kind kp ci cp ha :
  0 <= layer < 2^32 => 0 <= tree < 2^64 => 0 <= kind < 2^32 =>
  0 <= kp < 2^32 => 0 <= ci < 2^32 => 0 <= cp < 2^32 => 0 <= ha < 2^32 =>
  address layer tree kind kp ci cp ha = address_words layer tree kind kp ci cp ha.
proof.
  move=> hl ht hk hkp hci hcp hha.
  by rewrite /address /address_words (be4_common layer hl) (be8_common tree ht)
    (be4_common kind hk) (be4_common kp hkp) (be4_common ci hci)
    (be4_common cp hcp) (be4_common ha hha).
qed.

(* The existing chain model reconstructs addresses from fields. These
   equalities connect the extracted window updates to those actual addresses. *)
lemma chain_index_common layer tree kind kp oldci cp ha ci :
  0 <= ci < 2^32 =>
  chain_index_words (address layer tree kind kp oldci cp ha) ci =
    address layer tree kind kp ci cp ha.
proof.
  move=> hci; rewrite /chain_index_words /address -(be4_common ci hci).
  by rewrite !take_cat !drop_cat !size_cat !be_width //= !catA ?take0 ?drop0 ?cats0.
qed.

lemma chain_position_common layer tree kind kp ci oldcp ha cp :
  0 <= cp < 2^32 =>
  chain_position_words (address layer tree kind kp ci oldcp ha) cp =
    address layer tree kind kp ci cp ha.
proof.
  move=> hcp; rewrite /chain_position_words /address -(be4_common cp hcp).
  by rewrite !take_cat !drop_cat !size_cat !be_width //= ?take0 ?drop0 ?cats0.
qed.

(* PreparationView supplies each tag to the keyed oracle. Prefixing the
   explicit secret yields these common preimages; no oracle relation follows. *)
lemma wots_private_common secret layer tree kp ci :
  0 <= layer < 2^32 => 0 <= tree < 2^64 => 0 <= kp < 2^32 => 0 <= ci < 2^32 =>
  secret ++ wots_tag ++ wots_tail layer tree kp ci =
    wots_private_preimage secret layer tree kp ci.
proof.
  move=> hl ht hkp hci.
  by rewrite /wots_tag /wots_tail /wots_private_preimage
    (be4_common layer hl) (padded_tree_common tree ht)
    (be4_common kp hkp) (be4_common ci hci) !catA.
qed.

lemma fors_private_common secret ht tree leaf :
  0 <= ht < 2^32 => 0 <= tree < 2^32 => 0 <= leaf < 2^32 =>
  secret ++ fors_tag ++ fors_tail ht tree leaf = fors_private_preimage secret ht tree leaf.
proof.
  move=> hh htree hl.
  by rewrite /fors_tag /fors_tail /fors_private_preimage
    (be4_common _ hh) (be4_common tree htree) (be4_common leaf hl) !catA.
qed.
