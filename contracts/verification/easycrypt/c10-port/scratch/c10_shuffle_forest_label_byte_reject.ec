(* Exact operational shuffle correspondence to the paired representation.
   The oracle is arbitrary and its entire state is preserved. This does not
   identify that oracle with the supplied concrete-SHA model used in Lean. *)
require import AllCore List IntDiv.
require import C10Bytes C10RawOracle PrefixGuess PrefixHybrid KeygenPrefixes RawKeygen RawShuffle.
require import RawLayer.
(* Generated by easycrypt/c10-port/tools/c10_representation.py. Do not edit. Counts range over nonnegative integers; words are signed integers. *)

require import AllCore List IntDiv.

op byte_word_le (bs : (int list)) : int =
  (foldr (fun b acc => (b + (256 * acc))) 0 bs).

op byte_word (bs : (int list)) : int =
  (byte_word_le (rev bs)).

op word_window (bs : (int list)) (off : int) (width : int) : int =
  (((byte_word bs) %/ (2 ^ off)) %% (2 ^ width)).

op ht_field (bs : (int list)) : int =
  (word_window bs 143 18).

op fors_field (bs : (int list)) (t : int) : int =
  (word_window bs (11 * t) 11).

op wots_field (bs : (int list)) (i : int) : int =
  (word_window bs (3 * i) 3).

op wots_sum (bs : (int list)) : int =
  (foldr (fun b acc => (b + acc)) 0 (mkseq (fun i => (wots_field bs i)) 43)).

op wots_target  : int =
  205.

op fors_zero_field (bs : (int list)) : int =
  (word_window bs 132 11).

op word_nodes (n : int) (bs : (int list)) (off : int) : ((int list) list) =
  (mkseq (fun i => (take 16 (drop (off + (16 * i)) bs))) n).

op word_layer (bs : (int list)) (off : int) : (((int list) list) * int * ((int list) list)) =
  ((word_nodes 43 bs off), (byte_word (take 4 (drop (off + 688) bs))), (word_nodes 9 bs (off + 692))).

op word_decode (bs : (int list)) : ((int list) * ((int list) list) * (((int list) list) list) * ((((int list) list) * int * ((int list) list)) list)) =
  ((take 16 bs), (word_nodes 13 bs 16), (mkseq (fun t => (word_nodes 11 bs (224 + (176 * t)))) 12), (mkseq (fun l => (word_layer bs (2336 + (836 * l)))) 2)).

op pad_node (value : (int list)) : (int list) =
  (value ++ (nseq 16 0)).

op u32_bytes (nonce : int) : (int list) =
  (rev (mkseq (fun i => ((nonce %/ (2 ^ (8 * i))) %% 256)) 4)).

op hmsg_preimage (seed : (int list)) (root : (int list)) (random : (int list)) (message : (int list)) : (int list) =
  (seed ++ root ++ random ++ message ++ (nseq 32 255)).

op th_preimage (seed : (int list)) (address : (int list)) (value : (int list)) : (int list) =
  (seed ++ address ++ value).

op pair_preimage (seed : (int list)) (address : (int list)) (left : (int list)) (right : (int list)) : (int list) =
  (seed ++ address ++ left ++ right).

op multi_preimage (seed : (int list)) (address : (int list)) (values : ((int list) list)) : (int list) =
  (seed ++ address ++ (foldr (fun value tail => ((pad_node value) ++ tail)) [] values)).

op wots_preimage (seed : (int list)) (address : (int list)) (message : (int list)) (nonce : int) : (int list) =
  (seed ++ address ++ message ++ (nseq 28 0) ++ (u32_bytes nonce)).

op r_preimage (secret : (int list)) (random : (int list)) (message : (int list)) (nonce : int) : (int list) =
  (secret ++ [82; 95; 103; 114; 105; 110; 100] ++ random ++ message ++ (nseq 28 0) ++ (u32_bytes nonce)).

op u64_bytes (nonce : int) : (int list) =
  (rev (mkseq (fun i => ((nonce %/ (2 ^ (8 * i))) %% 256)) 8)).

op address_words (layer : int) (tree : int) (kind : int) (kp : int) (ci : int) (cp : int) (ha : int) : (int list) =
  ((u32_bytes layer) ++ (u64_bytes tree) ++ (u32_bytes kind) ++ (u32_bytes kp) ++ (u32_bytes ci) ++ (u32_bytes cp) ++ (u32_bytes ha)).

op chain_index_words (address : (int list)) (ci : int) : (int list) =
  ((take 20 address) ++ (u32_bytes ci) ++ (drop 24 address)).

op chain_position_words (address : (int list)) (cp : int) : (int list) =
  ((take 24 address) ++ (u32_bytes cp) ++ (drop 28 address)).

op wots_private_preimage (secret : (int list)) (layer : int) (tree : int) (kp : int) (ci : int) : (int list) =
  (secret ++ [119; 111; 116; 115] ++ (u32_bytes layer) ++ (nseq 24 0) ++ (u64_bytes tree) ++ (u32_bytes kp) ++ (u32_bytes ci)).

op fors_private_preimage (secret : (int list)) (ht : int) (tree : int) (leaf : int) : (int list) =
  (secret ++ [102; 111; 114; 115] ++ (u32_bytes ht) ++ (u32_bytes tree) ++ (u32_bytes leaf)).

op shuffle_forest_label  : (int list) =
  [102; 111; 114; 116].

op shuffle_layer_label (layer : int) : (int list) =
  (if layer = 0 then [119; 111; 116; 115; 45; 48; 0] else [119; 111; 116; 115; 45; 49; 0]).

op shuffle_seed_preimage (seed : (int list)) (label : (int list)) : (int list) =
  ([115; 112; 104; 105; 110; 99; 115; 45; 99; 49; 48; 45; 115; 104; 117; 102; 102; 108; 101; 45; 118; 49] ++ seed ++ label).

op shuffle_block_preimage (seed : (int list)) (nonce : int) : (int list) =
  ([115; 112; 104; 105; 110; 99; 115; 45; 99; 49; 48; 45; 102; 105; 115; 104; 101; 114; 45; 121; 97; 116; 101; 115; 45; 118; 49] ++ seed ++ (u32_bytes nonce)).

op shuffle_choice (lo : int) (hi : int) (bound : int) : int =
  ((((hi * 256) + lo) * bound) %/ 65536).

op shuffle_swap (order : (int list)) (i : int) (j : int) : (int list) =
  (put (put order i (nth 0 order j)) j (nth 0 order i)).

op shuffle_order (n : int) (stream : (int list)) : (int list) =
  (foldr (fun i order => (shuffle_swap order i (shuffle_choice (nth 0 stream (2 * (max 0 ((max 0 (n - 1)) - i)))) (nth 0 stream ((2 * (max 0 ((max 0 (n - 1)) - i))) + 1)) (i + 1)))) (mkseq (fun i => i) n) (mkseq (fun i => (i + 1)) (max 0 (n - 1)))).

op wots_first_slot (digests : ((int list) list)) : int =
  (foldr (fun digest slot => (if ((wots_sum digest) - (wots_target )) = 0 then 1 else (if slot = 0 then 0 else (slot + 1)))) 0 digests).

op fors_first_slot (digests : ((int list) list)) : int =
  (foldr (fun digest slot => (if (fors_zero_field digest) = 0 then 1 else (if slot = 0 then 0 else (slot + 1)))) 0 digests).

require import C10AddressInputBridge C10CallerInputBridge.

lemma shuffle_forest_label_common : [102;111;114;115] = shuffle_forest_label.
proof. by rewrite /shuffle_forest_label.
qed.

lemma shuffle_layer_label_common layer : layer_label layer = shuffle_layer_label layer.
proof. by rewrite /layer_label /shuffle_layer_label.
qed.

lemma shuffle_seed_common seed label :
  shuffle_tag ++ seed ++ label = shuffle_seed_preimage seed label.
proof. by rewrite /shuffle_tag /shuffle_seed_preimage.
qed.

lemma shuffle_block_common seed nonce : 0 <= nonce < 2^32 =>
  fisher_tag ++ seed ++ be 4 nonce = shuffle_block_preimage seed nonce.
proof. by move=> hn; rewrite /fisher_tag /shuffle_block_preimage (be4_common nonce hn).
qed.

op shuffle_finish n stream k order =
  foldr (fun i out => shuffle_swap out i
    (shuffle_choice (nth 0 stream (2 * max 0 (max 0 (n-1)-i)))
      (nth 0 stream (2 * max 0 (max 0 (n-1)-i)+1)) (i+1)))
    order (mkseq (fun j => j+1) k).

lemma shuffle_finish_zero n stream order :
  shuffle_finish n stream 0 order = order.
proof. by rewrite /shuffle_finish mkseq0.
qed.

lemma shuffle_finish_step n stream k order : 1 <= k =>
  shuffle_finish n stream k order = shuffle_finish n stream (k-1)
    (shuffle_swap order k
      (shuffle_choice (nth 0 stream (2 * max 0 (max 0 (n-1)-k)))
        (nth 0 stream (2 * max 0 (max 0 (n-1)-k)+1)) (k+1))).
proof.
  move=> hk; rewrite /shuffle_finish {1}(_: k=(k-1)+1) 1:/#.
  by rewrite mkseqS 1:/# foldr_rcons /=; smt().
qed.

lemma shuffle_finish_initial n stream : 1 <= n =>
  shuffle_finish n stream (n-1) (range 0 n) = shuffle_order n stream.
proof.
  move=> hn; rewrite /shuffle_finish /shuffle_order /range /mkseq /=.
  by rewrite (_: max 0 (n-1)=n-1) 1:/# map_id.
qed.

module PairedShuffle (O : PreparationOracle) = {
  proc derive(seed label : raw_input) : raw_input = {
    var d, result;
    result <- nseq 32 0;
    if (seed <> nseq 32 0) {
      d <@ O.hash(shuffle_seed_preimage seed label);
      result <- bits_to_bytes d;
    }
    return result;
  }
  proc permutation(seed : raw_input, n : int) : int list = {
    var order, stream, blk, d;
    order <- range 0 n;
    if (seed <> nseq 32 0 /\ 1 < n) {
      blk <- 0; stream <- [];
      while (blk < 4) {
        d <@ O.hash(shuffle_block_preimage seed blk);
        stream <- stream ++ bits_to_bytes d; blk <- blk+1;
      }
      order <- shuffle_order n stream;
    }
    return order;
  }
}.

lemma shuffle_derive_common (O <: PreparationOracle) :
  equiv [RawShuffle(O).derive ~ PairedShuffle(O).derive :
    ={arg, glob O} ==> ={res, glob O}].
proof.
  proc; sp 1 1; if; first by auto.
  + wp; call (_ : ={arg, glob O} ==> ={res, glob O}); first by sim.
    by auto; rewrite shuffle_seed_common.
  by auto.
qed.

lemma shuffle_permutation_common (O <: PreparationOracle) :
  equiv [RawShuffle(O).permutation ~ PairedShuffle(O).permutation :
    ={arg, glob O} /\ 0 <= n{1} <= 64 ==> ={res, glob O}].
proof.
  proc; sp 1 1; if; first by auto.
  + seq 3 3 : (={n, stream, glob O} /\ 1 < n{1} /\
      order{1} = range 0 n{1} /\ order{2} = range 0 n{2}).
    + while (={seed, n, stream, blk, glob O} /\ 0 <= blk{1} <= 4 /\
        1 < n{1} /\ order{1} = range 0 n{1} /\ order{2} = range 0 n{2}).
      + wp; call (_ : ={arg, glob O} ==> ={res, glob O}); first by sim.
        auto; move=> &1 &2 h.
        have hb : 0 <= blk{1} < 2^32 by rewrite caller_u32_size; smt().
        have hq := shuffle_block_common seed{1} blk{1} hb.
        have hnext : 0 <= blk{1}+1 <= 4 by smt().
        move: h => [#] hs hn hst hblk ho hb0 hb4 hn1 horder1 horder2 hg1 hg2.
        rewrite -hs -hn -hst -hblk -ho hq /=.
        rewrite hnext hn1 horder1 horder2 -hn /=.
        by move=> result_L result_R O_L O_R [-> ->].
      by auto; smt().
    wp 3 0.
    while{1} (={n, stream, glob O} /\ 1 < n{1} /\
      0 <= i{1} < n{1} /\ pos{1} + 2*i{1} = 2*(n{1}-1) /\
      shuffle_finish n{1} stream{1} i{1} order{1} = shuffle_order n{2} stream{2})
      i{1}.
    + move=> &m z; auto; move=> &hr [hinv hguard].
      have hi : 1 <= i{hr} by smt().
      have hp : 2 * max 0 (max 0 (n{hr}-1)-i{hr}) = pos{hr} by smt().
      have hs := shuffle_finish_step n{hr} stream{hr} i{hr} order{hr} hi.
      rewrite /shuffle_swap /shuffle_choice hp in hs.
      rewrite /= -hs; smt().
    auto; move=> &1 &2 [#] hn hstream hO hn1 ho1 ho2.
    have hnpos : 1 <= n{1} by smt().
    have hrange : 0 <= n{1}-1 < n{1} by smt().
    rewrite /= -hn -hstream -hO ho1 (shuffle_finish_initial n{1} stream{1} hnpos) hrange /=.
    rewrite hn1 /=; move=> i order pos; split.
    + smt().
    move=> hexit [#] hi0 hilt hpos hf.
    have hi : i = 0 by smt().
    by move: hf; rewrite hi shuffle_finish_zero => ->.
  by auto.
qed.
