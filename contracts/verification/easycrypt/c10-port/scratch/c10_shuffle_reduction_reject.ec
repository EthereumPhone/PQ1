op forest_compress_value (hash_fn : (int list -> int list)) (seed : (int list)) (ht : int) (values : ((int list) list)) : (int list) =
  (hash_bytes_node hash_fn (multi_preimage seed (address_words 0 ht 4 0 0 0 0) values)).

op forest_recover_value (hash_fn : (int list -> int list)) (seed : (int list)) (ht : int) (forest_indices : (int list)) (forest_secrets : ((int list) list)) (forest_paths : (((int list) list) list)) : (int list) =
  (forest_compress_value hash_fn seed ht (forest_recover_roots hash_fn seed ht forest_indices forest_secrets forest_paths)).

op forest_sign_value (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (ht : int) (forest_indices : (int list)) : (((int list) list) * (((int list) list) list) * (int list)) =
  ((forest_sign_secrets hash_fn seed secret ht forest_indices), (forest_sign_paths hash_fn seed secret ht forest_indices), (forest_recover_value hash_fn seed ht forest_indices (forest_sign_secrets hash_fn seed secret ht forest_indices) (forest_sign_paths hash_fn seed secret ht forest_indices))).

op wots_search_digests (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kp : int) (message : (int list)) : ((int list) list) =
  (mkseq (fun i => (hash_fn (wots_preimage seed (address_words layer tree 0 kp 0 0 0) (pad_node message) (i)))) 10000000).

op layer_sign_slot (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kp : int) (message : (int list)) : int =
  (wots_first_slot (wots_search_digests hash_fn seed layer tree kp message)).

op layer_sign_values (hash_fn : (int list -> int list)) (seed : (int list)) (secret : (int list)) (layer : int) (tree : int) (kp : int) (message : (int list)) (nonce : int) : (((int list) list) * int * ((int list) list)) =
  ((wots_sign_values hash_fn seed secret layer tree kp (hash_fn (wots_preimage seed (address_words layer tree 0 kp 0 0 0) (pad_node message) nonce))), nonce, (merkle_auth_values hash_fn seed secret layer tree kp)).

op layer_recover_value (hash_fn : (int list -> int list)) (seed : (int list)) (layer : int) (tree : int) (kp : int) (message : (int list)) (values : ((int list) list)) (nonce : int) (auth : ((int list) list)) : (int list) =
  (merkle_recover_value hash_fn seed layer tree (wots_recover_value hash_fn seed layer tree kp message values nonce) kp auth).

op digest_fors_indices (bs : (int list)) : (int list) =
  (mkseq (fun i => (fors_field bs i)) 13).

op verifier_digest (hash_fn : (int list -> int list)) (seed : (int list)) (root : (int list)) (random : (int list)) (message : (int list)) : (int list) =
  (hash_fn (hmsg_preimage seed root (pad_node random) message)).

op digest_forest_value (hash_fn : (int list -> int list)) (seed : (int list)) (bs : (int list)) (forest_secrets : ((int list) list)) (forest_paths : (((int list) list) list)) : (int list) =
  (forest_recover_value hash_fn seed (ht_field bs) (digest_fors_indices bs) forest_secrets forest_paths).

op hypertree_first_value (hash_fn : (int list -> int list)) (seed : (int list)) (ht : int) (message : (int list)) (values : ((int list) list)) (nonce : int) (auth : ((int list) list)) : (int list) =
  (layer_recover_value hash_fn seed 0 (ht %/ 512) (ht %% 512) message values nonce auth).

op hypertree_recover_value (hash_fn : (int list -> int list)) (seed : (int list)) (ht : int) (message : (int list)) (values0 : ((int list) list)) (nonce0 : int) (auth0 : ((int list) list)) (values1 : ((int list) list)) (nonce1 : int) (auth1 : ((int list) list)) : (int list) =
  (layer_recover_value hash_fn seed 1 ((ht %/ 512) %/ 512) ((ht %/ 512) %% 512) (hypertree_first_value hash_fn seed ht message values0 nonce0 auth0) values1 nonce1 auth1).

op verifier_recover_value (hash_fn : (int list -> int list)) (seed : (int list)) (bs : (int list)) (forest_secrets : ((int list) list)) (forest_paths : (((int list) list) list)) (values0 : ((int list) list)) (nonce0 : int) (auth0 : ((int list) list)) (values1 : ((int list) list)) (nonce1 : int) (auth1 : ((int list) list)) : (int list) =
  (hypertree_recover_value hash_fn seed (ht_field bs) (digest_forest_value hash_fn seed bs forest_secrets forest_paths) values0 nonce0 auth0 values1 nonce1 auth1).

require import C10AddressInputBridge C10CallerInputBridge.

lemma shuffle_forest_label_common : [102;111;114;115] = shuffle_forest_label.
proof. by rewrite /shuffle_forest_label.
qed.

lemma shuffle_layer_label_common layer : layer_label layer = shuffle_layer_label layer.
proof. by rewrite /layer_label /shuffle_layer_label.
qed.

lemma shuffle_seed_common seed label :
  shuffle_tag ++ seed ++ label = shuffle_seed_preimage seed label.
proof. by rewrite /shuffle_tag /shuffle_seed_preimage.
qed.

lemma shuffle_block_common seed nonce : 0 <= nonce < 2^32 =>
  fisher_tag ++ seed ++ be 4 nonce = shuffle_block_preimage seed nonce.
proof. by move=> hn; rewrite /fisher_tag /shuffle_block_preimage (be4_common nonce hn).
qed.

op shuffle_finish n stream k order =
  foldr (fun i out => shuffle_swap out i
    (shuffle_choice (nth 0 stream (2 * max 0 (max 0 (n-1)-i)))
      (nth 0 stream (2 * max 0 (max 0 (n-1)-i)+1)) (i+1)))
    order (mkseq (fun j => j+1) k).

lemma shuffle_finish_zero n stream order :
  shuffle_finish n stream 0 order = order.
proof. by rewrite /shuffle_finish mkseq0.
qed.

lemma shuffle_finish_step n stream k order : 1 <= k =>
  shuffle_finish n stream k order = shuffle_finish n stream (k-1)
    (shuffle_swap order k
      (shuffle_choice (nth 0 stream (2 * max 0 (max 0 (n-1)-k)))
        (nth 0 stream (2 * max 0 (max 0 (n-1)-k)+1)) (k+1))).
proof.
  move=> hk; rewrite /shuffle_finish {1}(_: k=(k-1)+1) 1:/#.
  by rewrite mkseqS 1:/# foldr_rcons /=; smt().
qed.

lemma shuffle_finish_initial n stream : 1 <= n =>
  shuffle_finish n stream (n-1) (range 0 n) = shuffle_order n stream.
proof.
  move=> hn; rewrite /shuffle_finish /shuffle_order /range /mkseq /=.
  by rewrite (_: max 0 (n-1)=n-1) 1:/# map_id.
qed.

module PairedShuffle (O : PreparationOracle) = {
  proc derive(seed label : raw_input) : raw_input = {
    var d, result;
    result <- nseq 32 0;
    if (seed <> nseq 32 0) {
      d <@ O.hash(shuffle_seed_preimage seed label);
      result <- bits_to_bytes d;
    }
    return result;
  }
  proc permutation(seed : raw_input, n : int) : int list = {
    var order, stream, blk, d;
    order <- range 0 n;
    if (seed <> nseq 32 0 /\ 1 < n) {
      blk <- 0; stream <- [];
      while (blk < 4) {
        d <@ O.hash(shuffle_block_preimage seed blk);
        stream <- stream ++ bits_to_bytes d; blk <- blk+1;
      }
      order <- shuffle_order n stream;
    }
    return order;
  }
}.

lemma shuffle_derive_common (O <: PreparationOracle) :
  equiv [RawShuffle(O).derive ~ PairedShuffle(O).derive :
    ={arg, glob O} ==> ={res, glob O}].
proof.
  proc; sp 1 1; if; first by auto.
  + wp; call (_ : ={arg, glob O} ==> ={res, glob O}); first by sim.
    by auto; rewrite shuffle_seed_common.
  by auto.
qed.

lemma shuffle_permutation_common (O <: PreparationOracle) :
  equiv [RawShuffle(O).permutation ~ PairedShuffle(O).permutation :
    ={arg, glob O} /\ 0 <= n{1} <= 64 ==> ={res, glob O}].
proof.
  proc; sp 1 1; if; first by auto.
  + seq 3 3 : (={n, stream, glob O} /\ 1 < n{1} /\
      order{1} = range 0 n{1} /\ order{2} = range 0 n{2}).
    + while (={seed, n, stream, blk, glob O} /\ 0 <= blk{1} <= 4 /\
        1 < n{1} /\ order{1} = range 0 n{1} /\ order{2} = range 0 n{2}).
      + wp; call (_ : ={arg, glob O} ==> ={res, glob O}); first by sim.
        auto; move=> &1 &2 h.
        have hb : 0 <= blk{1} < 2^32 by rewrite caller_u32_size; smt().
        have hq := shuffle_block_common seed{1} blk{1} hb.
        have hnext : 0 <= blk{1}+1 <= 4 by smt().
        move: h => [#] hs hn hst hblk ho hb0 hb4 hn1 horder1 horder2 hg1 hg2.
        rewrite -hs -hn -hst -hblk -ho hq /=.
        rewrite hnext hn1 horder1 horder2 -hn /=.
        by move=> result_L result_R O_L O_R [-> ->].
      by auto; smt().
    wp 3 0.
    while{1} (={n, stream, glob O} /\ 1 < n{1} /\
      0 <= i{1} < n{1} /\ pos{1} + 2*i{1} = 2*(n{1}-1) /\
      shuffle_finish n{1} stream{1} i{1} order{1} = shuffle_order n{2} stream{2})
      i{1}.
    + move=> &m z; auto; move=> &hr [hinv hguard].
      have hi : 1 <= i{hr} by smt().
      have hp : 2 * max 0 (max 0 (n{hr}-1)-i{hr}) = pos{hr} by smt().
      have hs := shuffle_finish_step n{hr} stream{hr} i{hr} order{hr} hi.
      rewrite /shuffle_swap /shuffle_choice hp in hs.
      rewrite /= -hs; smt().
    auto; move=> &1 &2 [#] hn hstream hO hn1 ho1 ho2.
    have hnpos : 1 <= n{1} by smt().
    have hrange : 0 <= n{1}-1 < n{1} by smt().
    rewrite /= -hn -hstream -hO ho1 (shuffle_finish_initial n{1} stream{1} hnpos) hrange /=.
    rewrite hn1 /=; move=> i order pos; split.
    + smt().
    move=> hexit [#] hi0 hilt hpos hf.
    have hi : i = 0 by smt().
    by move: hf; rewrite hi shuffle_finish_zero => ->.
  by auto.
qed.
