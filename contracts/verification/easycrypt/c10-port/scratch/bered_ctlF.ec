(* ==========================================================================
   BadEncToTColl.ec  --  STEPS 2 and 3 of the BadEnc -> +C reduction.

   ###################  READ THIS BEFORE CITING THE FILE  ###################
   STEP 4 (the probability inequality) IS NOT PROVED HERE (it is BadEncStep4.ec).  What is here is the
   simulation module and the EVENT-LEVEL implication.  Neither changes any
   bound anywhere in the development.
   ##########################################################################

   STEP 2  `R_TCOLL(A)` -- the +C adversary A, played against T_COLL_RES_ENUM.
   STEP 3  `badenc_win_gives_tcoll_core` -- a BadEnc win by `R_int_WOTSTW(A)`
           yields a (B2) witness: two DISTINCT `ThC` images at a COMMON (ps, ad)
           whose codewords agree and which both pass the +C gate `P`.  That is
           `EncNonInjOnThCSurface`, the same op `tcoll_win_needs_coll`
           (`cdrafts-split/TCollResEnum.ec` section 5) extracts from a win of the
           target game.  So both sides of the intended boundary now provably
           speak the same residual.

   WHY `R_TCOLL` LOOKS LIKE `R_int_STCRC` AND NOT LIKE `R_int_WOTSTW`
   -----------------------------------------------------------------
   The target oracle returns `(e, ctr)` -- an ENCODING and a counter, not a
   WOTS signature (`cdrafts-split/TCollResEnum.ec`, `O_TCollEnum_Default.query`).  So
   the reduction must build the WOTS material itself, WITHOUT holding `ps`
   during `pick()`.  That is exactly `R_int_STCRC`'s problem
   (`cdrafts-split/WOTS_C_Interactive.ec:586`), whose answer is: self-generate the chain
   starting points and walk the chains through the COLLECTION oracle `OC`, which
   does hold `ps`.  Two deliberate departures from that template:

     (a) `R_int_STCRC` receives the DIGEST `d` and computes
         `em <- encode_msgWOTS d`.  Here the oracle already returns `e`, so that
         line is DROPPED -- the reduction never learns `d`.  This is not a
         convenience: it is the whole reason the +C layer is the right home for
         the charge (the digest is a keyed value the adversary does not choose,
         and the reduction does not choose it either).
     (b) The SIGNATURE SHAPE mirrors `O_Game34_WOTSTWES_AltX`
         (`base-c10-split/WOTS_TW_ES.ec:3291`), NOT the honest signer: `sk_ele` is
         sampled PER ELEMENT inside the loop and the signature element is ONE
         `f`-step from it (`cf ps ad (em_ele - 1) 1`), with the public-key
         element completing the chain to `w - 1`.  Game 4 is the artificial game
         in which the chain below the signature has already been replaced by a
         random node, so this is the shape the left-hand side actually runs.

         The temptation is to copy `R_int_STCRC`'s `xl <$ ddgstblockl` list
         sample.  DO NOT: relating a list sample to a per-element loop needs
         `DList.Program`, which `base-c10-split/WOTS_TW_ES.ec` clones LOCALLY INSIDE
         its section (`local clone import DList.Program as DListSample`) and is
         therefore not reusable from here.  Copying the template would have
         imported a distribution hop that cannot be discharged with the
         available clones.

   `OC` TWEAK TRANSCRIPTS DIFFER BETWEEN THE TWO SIDES, ON PURPOSE
   --------------------------------------------------------------
   `R_int_WOTSTW` makes two `OC` queries per grind candidate (`cdrafts-split/
   WOTS_C_Interactive.ec`, ROUTE (D)); here the grind is INTERNAL to the target
   oracle and is a pure op (`grindC`), so the reduction makes none.  The
   accumulated `FC.O_THFC_Default.tws` lists are therefore wildly different.
   That is harmless BY DESIGN and the reason is already recorded twice, so it is
   cited rather than re-derived: (i) `T_COLL_RES_ENUM` has NO disjointness
   conjunct and never calls `get_tweaks` (`cdrafts-split/TCollResEnum.ec`,
   FAITHFULNESS NOTES); (ii) `OC.query`'s result is a function of `(pp, tw, x)`
   only, independent of the accumulated `tws`, and A can neither read
   `get_tweaks` nor query anything in `forge` -- the "faithfulness lynchpin" of
   `cdrafts-split/WOTS_C_Interactive.ec` PART 6.

   AXIOM / ADMIT LEDGER.  0 admits, 0 axioms, 0 `declare axiom`.

   BUILD.  A closure member since 2026-09-14, compiled as a target by
   `cert_gate_split.sh`; pre-promotion receipt
   `experiments/wots-badenc/red/BadEncToTColl.out`.
   ========================================================================== *)
require import AllCore List Distr.
require import SPHINCS_PLUS.
require WOTS_C_Real.
require import WOTS_C_Scheme.
require import TCollResEnum.
require import BadEncSplit.
require import WOTS_C_Interactive.
import FSSLXMTWES.WTWES.
import HA.Adrs.
import WOTS_C_Real.
import EmsgWOTS.        (* for `em.[i]`; SHADOWS `val`, so every projection
                           below is qualified by its type *)

(* ==========================================================================
   STEP 2.  THE SIMULATION.

   `R_TCOLL(A)` plays T_COLL_RES_ENUM and presents A with the +C signing oracle
   it expects.  Target registration is per-query and adaptive: exactly one
   `O.query` per A signing query, so the target list and A's own query list stay
   index-parallel and A's forgery index `i` is directly usable by `find`.
   ========================================================================== *)
module (R_TCOLL (A : Adv_MEUFGCMA_WOTSC) : Adv_TCollResEnum)
       (O : Oracle_TCollEnum, OC : FC.Oracle_THFC) = {

  module O_wrap : Oracle_MEUFGCMA_WOTSC = {
    include var O_MEUFGCMA_WOTSC_Default [-init, query]

    proc init(ps_init : pseed) : unit = {
      qs <- [];
    }

    proc query(wad : wadrs, m : dgstblock) : pkWOTS * (sigWOTS * cntr) = {
      var ad : adrs;
      var em : EmsgWOTS.emsgWOTS;   (* the ENCODING, straight from the target *)
      var c : cntr;                 (* the grinded counter, ditto             *)
      var sk, sig, pk : dgstblock list;
      var sk_ele, sig_ele, pk_ele : dgstblock;
      var em_ele, j : int;

      ad <- WAddress.val wad;

      (* register the +C target at `ad` AND obtain (encoding, counter).  The
         reduction never sees the digest `ThC ps ad m c` itself. *)
      (em, c) <@ O.query(ad, m);

      (* -- Game-4 signature shape: random node one step below the signature -- *)
      sk  <- [];
      sig <- [];
      while (size sig < len) {
        sk_ele <$ ddgstblock;
        em_ele <- BaseW.val em.[size sig];
        if (em_ele = 0) {
          sig_ele <- sk_ele;
        } else {
          sig_ele <@ OC.query(set_hidx (set_chidx ad (size sig)) (em_ele - 1),
                              DigestBlock.val sk_ele);
        }
        sk  <- rcons sk sk_ele;
        sig <- rcons sig sig_ele;
      }

      (* -- public key: finish each chain from `em_ele` up to `w - 1` via OC -- *)
      pk <- [];
      while (size pk < len) {
        sig_ele <- nth witness sig (size pk);
        em_ele  <- BaseW.val em.[size pk];
        pk_ele  <- sig_ele;
        j       <- em_ele;
        while (j < w - 1) {
          pk_ele <@ OC.query(set_hidx (set_chidx ad (size pk)) j,
                             DigestBlock.val pk_ele);
          j <- j + 1;
        }
        pk <- rcons pk pk_ele;
      }

      qs <- rcons qs (ad, m, DBLL.insubd pk, (DBLL.insubd sig, c));
      return (DBLL.insubd pk, (DBLL.insubd sig, c));
    }
  }

  module AA = A(O_wrap, OC)

  proc pick() : unit = {
    O_wrap.init(witness);
    AA.choose();
  }

  (* With `ps` revealed, relay A's +C forgery on instance `i` as the target
     collision candidate (i, m', ctr').  The game itself computes
     `ThC ps ad m' ctr'` at the RECORDED address of entry `i`, so the reduction
     does not get to choose the tweak -- which is what makes the win a collision
     at a COMMON (ps, ad). *)
  proc find(ps : pseed) : int * dgstblock * cntr = {
    var i : int;
    var m' : dgstblock;
    var sigc' : sigWOTS * cntr;

    (i, m', sigc') <@ AA.forge(ps);
    return (i, m', sigc'.`2);
  }
}.

(* ==========================================================================
   STEP 3.  THE EVENT-LEVEL LEMMA.

   A BadEnc win by `R_int_WOTSTW(A)` yields a (B2) witness.

   THE SINGLE LOAD-BEARING INVARIANT is `wads_parallel`: without it `is_fresh`
   compares two `ThC` images at POSSIBLY DIFFERENT tweaks, and that is NOT
   `EncNonInjOnThCSurface` (which quantifies ONE common `ad`).  It is stated as
   a named op and carried explicitly rather than inlined into the proof.
   ========================================================================== *)

(* Every recorded WOTS-TW query message is a `ThC` image AT ITS OWN recorded
   address -- true because the ONLY writer of `O_MEUFGCMA_WOTSTWESNPRF.qs` on
   this path is `O_Game34_WOTSTWES_AltX.query`, and the only caller of that is
   `R_int_WOTSTW.O_wrap.query`, which submits `d = ThC ps ad m c`. *)
op qs_ThC_images (ps : pseed)
                 (qs : (adrs * msgWOTS * pkWOTS * sigWOTS) list) : bool =
  all (fun (q : adrs * msgWOTS * pkWOTS * sigWOTS) =>
         exists (x : dgstblock) (cc : cntr), q.`2 = ThC ps q.`1 x cc) qs.

(* The reduction's address log and the WOTS-TW oracle's query log are
   index-parallel -- both are `rcons`ed exactly once per `O_wrap.query` call. *)
op wads_parallel (wads : wadrs list)
                 (qs : (adrs * msgWOTS * pkWOTS * sigWOTS) list) : bool =
  map WAddress.val wads
  = map (fun (q : adrs * msgWOTS * pkWOTS * sigWOTS) => q.`1) qs.

(* The two logs grow by exactly one entry per `O_wrap.query` call, and each
   invariant is closed under that step.  Stated separately so the game proof
   consumes a named fact rather than re-deriving list algebra inline. *)
lemma wads_parallel_rcons (wads : wadrs list)
      (qs : (adrs * msgWOTS * pkWOTS * sigWOTS) list)
      (wad : wadrs) (q : adrs * msgWOTS * pkWOTS * sigWOTS) :
     wads_parallel wads qs
  => q.`1 = WAddress.val wad
  => wads_parallel (rcons wads wad) (rcons qs q).
proof. by rewrite /wads_parallel !map_rcons /= => -> ->. qed.

lemma qs_ThC_images_rcons (ps : pseed)
      (qs : (adrs * msgWOTS * pkWOTS * sigWOTS) list)
      (q : adrs * msgWOTS * pkWOTS * sigWOTS) (x : dgstblock) (cc : cntr) :
     qs_ThC_images ps qs
  => q.`2 = ThC ps q.`1 x cc
  => qs_ThC_images ps (rcons qs q).
proof.
rewrite /qs_ThC_images -cats1 all_cat => hall hq /=.
rewrite hall /=.
by exists x cc.
qed.

(* The target implication, as a named op so the `conseq` step below can quote it
   and so the pure content is separated from the program logic. *)
op badenc_target (ps : pseed)
                 (qs : (adrs * msgWOTS * pkWOTS * sigWOTS) list)
                 (i : int) (m m' : msgWOTS) : bool =
     (   0 <= i < size qs
      /\ m' <> m                                          (* is_fresh *)
      /\ P m /\ P m'                                      (* the +C gates *)
      /\ encode_msgWOTS m = encode_msgWOTS m')            (* BadEncFlag.badenc *)
  => EncNonInjOnThCSurface.

(* -- The two invariants, each turned into a PROOF TERM the core lemma consumes
      by `exact`/application.  This shape is deliberate control hygiene (the
      same reasoning as `cdrafts-split/TCollResEnum.ec`'s `W_*_at` lemmas): had the
      core lemma instead done `rewrite ... hpar`, a control replacing `hpar` by
      `true` would fail at the REWRITE -- which only shows the script MENTIONS
      the hypothesis.  Failing on a proof-term application shows it CLOSES the
      goal. -- *)

(* This is what supplies the COMMON `ad`.  Delete it and the two ThC images sit
   at unrelated tweaks, which is not `EncNonInjOnThCSurface` at all. *)
lemma parallel_gives_common_addr (wads : wadrs list)
      (qs : (adrs * msgWOTS * pkWOTS * sigWOTS) list) (i : int) :
     wads_parallel wads qs
  => 0 <= i < size qs
  => WAddress.val (nth witness wads i) = (nth witness qs i).`1.
proof.
move=> hpar hi.
have hsz : size wads = size qs.
+ by move: hpar; rewrite /wads_parallel -(size_map WAddress.val) => ->; rewrite size_map.
rewrite -(nth_map witness witness WAddress.val); first by smt().
by move: hpar; rewrite /wads_parallel => ->; rewrite (nth_map witness witness); smt().
qed.

(* This is what makes the retrieved message a ThC IMAGE rather than an opaque
   msgWOTS -- without it there is no (ps, ad, x, c) to instantiate with. *)
lemma images_give_ThC (ps : pseed)
      (qs : (adrs * msgWOTS * pkWOTS * sigWOTS) list) (i : int) :
     qs_ThC_images ps qs
  => 0 <= i < size qs
  => exists (x : dgstblock) (cc : cntr),
       (nth witness qs i).`2 = ThC ps (nth witness qs i).`1 x cc.
proof.
move=> himg hi.
move: himg; rewrite /qs_ThC_images allP => h.
by apply (h (nth witness qs i)); apply mem_nth; smt().
qed.

(* `is_fresh` is stated forged-vs-retrieved; the (B2) witness wants
   retrieved-vs-forged. *)
lemma neq_sym_msgWOTS (a b : msgWOTS) : a <> b => b <> a.
proof. smt(). qed.

(* THE PURE CORE OF STEP 3.  Given the two invariants, the game's own values
   (retrieved entry `i`, forged message built at `wads`' i-th address) satisfy
   the target implication. *)
lemma badenc_target_from_inv (ps : pseed)
      (qs : (adrs * msgWOTS * pkWOTS * sigWOTS) list)
      (wads : wadrs list) (i : int) (x' : dgstblock) (c' : cntr) :
     wads_parallel wads qs
  => true
  => badenc_target ps qs i (nth witness qs i).`2
       (ThC ps (WAddress.val (nth witness wads i)) x' c').
proof.
move=> hpar himg.
(* `0 <= i < size qs` is ONE top-level component (the `<=`/`<` chain is
   parenthesised as a unit), so the pattern has five, not six. *)
rewrite /badenc_target => -[hi [hne [hP [hP' hcol]]]].
have hval := parallel_gives_common_addr wads qs i hpar hi.
have [x cc hm] := images_give_ThC ps qs i himg hi.
apply (freshness_gives_tcoll_core ps (nth witness qs i).`1 x x' cc c').
+ by rewrite -hm -hval; exact (neq_sym_msgWOTS _ _ hne).
+ by rewrite -hm -hval; exact hcol.
by rewrite -hm; exact hP.
qed.

section Step3.

declare module A <: Adv_MEUFGCMA_WOTSC{-O_MEUFGCMA_WOTSTWESNPRF,
                                       -O_MEUFGCMA_WOTSC_Default,
                                       -R_int_WOTSTW, -FC.O_THFC_Default}.

lemma badenc_win_gives_tcoll_core :
  hoare[ Game4_WOTSTWES_BadEnc(R_int_WOTSTW(A)).main :
           true ==> res /\ BadEncFlag.badenc => EncNonInjOnThCSurface ].
proof.
proc.
inline *.
wp.
(* Weaken the postcondition to the part that carries information: the WOTS-TW
   validity / disjointness / chain-collision conjuncts are hypotheses we never
   use, and `pkWOTS0` (the verify loop's accumulator) appears only inside them. *)
conseq (_ : _ ==> badenc_target ps O_MEUFGCMA_WOTSTWESNPRF.qs i m m').
+ by rewrite /badenc_target => &hr h [] /> *; smt().
while (badenc_target ps O_MEUFGCMA_WOTSTWESNPRF.qs i m m').
+ by auto.
wp.
call (: FC.O_THFC_Default.pp = O_MEUFGCMA_WOTSTWESNPRF.ps
     /\ wads_parallel R_int_WOTSTW.O_wrap.wads O_MEUFGCMA_WOTSTWESNPRF.qs
     /\ qs_ThC_images O_MEUFGCMA_WOTSTWESNPRF.ps O_MEUFGCMA_WOTSTWESNPRF.qs).
wp.
call (: FC.O_THFC_Default.pp = O_MEUFGCMA_WOTSTWESNPRF.ps
     /\ wads_parallel R_int_WOTSTW.O_wrap.wads O_MEUFGCMA_WOTSTWESNPRF.qs
     /\ qs_ThC_images O_MEUFGCMA_WOTSTWESNPRF.ps O_MEUFGCMA_WOTSTWESNPRF.qs).
+ (* the reduction's signing wrapper: one `rcons` on each of the two logs *)
  proc.
  inline O_Game34_WOTSTWES_AltX.query.
  wp.
  while (FC.O_THFC_Default.pp = O_MEUFGCMA_WOTSTWESNPRF.ps
      /\ wads_parallel R_int_WOTSTW.O_wrap.wads O_MEUFGCMA_WOTSTWESNPRF.qs
      /\ qs_ThC_images O_MEUFGCMA_WOTSTWESNPRF.ps O_MEUFGCMA_WOTSTWESNPRF.qs
      /\ ad0 = WAddress.val wad /\ m0 = ThC O_MEUFGCMA_WOTSTWESNPRF.ps ad0 m c).
  + by auto.
  wp.
  while (FC.O_THFC_Default.pp = O_MEUFGCMA_WOTSTWESNPRF.ps
      /\ wads_parallel R_int_WOTSTW.O_wrap.wads O_MEUFGCMA_WOTSTWESNPRF.qs
      /\ qs_ThC_images O_MEUFGCMA_WOTSTWESNPRF.ps O_MEUFGCMA_WOTSTWESNPRF.qs
      /\ ad0 = WAddress.val wad /\ m0 = ThC O_MEUFGCMA_WOTSTWESNPRF.ps ad0 m c).
  + by auto.
  wp.
  inline FC.O_THFC_Default.query.
  wp.
  while (FC.O_THFC_Default.pp = O_MEUFGCMA_WOTSTWESNPRF.ps
      /\ wads_parallel R_int_WOTSTW.O_wrap.wads O_MEUFGCMA_WOTSTWESNPRF.qs
      /\ qs_ThC_images O_MEUFGCMA_WOTSTWESNPRF.ps O_MEUFGCMA_WOTSTWESNPRF.qs
      /\ ad = WAddress.val wad).
  + by inline FC.O_THFC_Default.query; auto.
  (* Residual (read off `experiments/wots-badenc/red/dump.sh`, not guessed): the two logs each grew by one
     entry, and the ThC equation for the new entry is already a hypothesis --
     it is the grind loop's exit fact fed through `ThC_E`. *)
  auto => /> &hr hpar himg c0 cs0 found0 _ sig0 _ hThC pk00 _.
  split; first by apply (wads_parallel_rcons _ _ _ _ hpar).
  by apply (qs_ThC_images_rcons _ _ _ m{hr} c0 himg).
+ (* the collection oracle touches neither log *)
  by proc; auto.
(* Residual (read off `experiments/wots-badenc/red/dump.sh`): the initial invariant is trivial at the
   empty logs, and the rest is EXACTLY `badenc_target_from_inv` at the
   adversary's own output. *)
auto => /> ps _ _ _ wads qs hpar himg result.
by apply (badenc_target_from_inv ps qs wads result.`1 result.`2 result.`3.`2
            hpar himg).
qed.

end section Step3.
