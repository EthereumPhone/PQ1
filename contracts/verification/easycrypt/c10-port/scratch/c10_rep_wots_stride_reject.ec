(* Actual EasyCrypt digest fields and complete wire decoder refine the common
   generated integer/list forms. The paired Lean proofs cover the extracted
   readers and actual parser values. No full-session/probability transfer or
   cross-kernel certificate is claimed. *)
require import AllCore List IntDiv Ring BitEncoding.
require import C10Bytes RawForest RawWots RawSignature.
(* Generated by easycrypt/c10-port/tools/c10_representation.py. Do not edit. Counts range over nonnegative integers; words are signed integers. *)

require import AllCore List IntDiv.

op byte_word_le (bs : (int list)) : int =
  (foldr (fun b acc => (b + (256 * acc))) 0 bs).

op byte_word (bs : (int list)) : int =
  (byte_word_le (rev bs)).

op word_window (bs : (int list)) (off : int) (width : int) : int =
  (((byte_word bs) %/ (2 ^ off)) %% (2 ^ width)).

op ht_field (bs : (int list)) : int =
  (word_window bs 143 18).

op fors_field (bs : (int list)) (t : int) : int =
  (word_window bs (11 * t) 11).

op wots_field (bs : (int list)) (i : int) : int =
  (word_window bs (4 * i) 3).

op word_nodes (n : int) (bs : (int list)) (off : int) : ((int list) list) =
  (mkseq (fun i => (take 16 (drop (off + (16 * i)) bs))) n).

op word_layer (bs : (int list)) (off : int) : (((int list) list) * int * ((int list) list)) =
  ((word_nodes 43 bs off), (byte_word (take 4 (drop (off + 688) bs))), (word_nodes 9 bs (off + 692))).

op word_decode (bs : (int list)) : ((int list) * ((int list) list) * (((int list) list) list) * ((((int list) list) * int * ((int list) list)) list)) =
  ((take 16 bs), (word_nodes 13 bs 16), (mkseq (fun t => (word_nodes 11 bs (224 + (176 * t)))) 12), (mkseq (fun l => (word_layer bs (2336 + (836 * l)))) 2)).

import BS2Int.

lemma byte_word_le_value bs :
  all (fun b => 0 <= b < 256) bs =>
  bs2int (flatten (map (int2bs 8) bs)) = byte_word_le bs.
proof.
  rewrite /byte_word_le.
  elim: bs => [|b bs ih] /=.
  + by rewrite bs2int_nil.
  move=> [hb hbs].
  have hp : 2^8=256 by rewrite (_:8=2*2*2) 1:// !IntID.exprM !IntID.expr2.
  rewrite flatten_cons bs2int_cat size_int2bs /= (int2bsK 8 b) 1:// 1:/#.
  by rewrite (ih hbs) hp.
qed.

lemma byte_word_value bs :
  all (fun b => 0 <= b < 256) bs =>
  bs2int (bytes_to_bits bs) = byte_word bs.
proof.
  move=> hb; rewrite /bytes_to_bits /byte_word byte_word_le_value // all_rev.
  exact hb.
qed.

lemma byte_window bs off width :
  0 <= off => 0 <= width => all (fun b => 0 <= b < 256) bs =>
  bs2int (take width (drop off (bytes_to_bits bs))) =
    (byte_word bs %/ 2^off) %% 2^width.
proof.
  move=> ho hw hb.
  by rewrite -bs2int_mod // -bs2int_div // byte_word_value.
qed.

lemma hypertree_field_bytes bs :
  all (fun b => 0 <= b < 256) bs =>
  hypertree_index (bytes_to_bits bs) = (byte_word bs %/ 2^143) %% 2^18.
proof. by move=> hb; rewrite /hypertree_index byte_window. qed.

lemma forest_field_bytes bs t :
  0 <= t => all (fun b => 0 <= b < 256) bs =>
  forest_index (bytes_to_bits bs) t = (byte_word bs %/ 2^(11*t)) %% 2^11.
proof. move=> ht hb; rewrite /forest_index byte_window //; smt(). qed.

lemma wots_field_bytes bs j :
  size bs = 32 => 0 <= j < 43 => all (fun b => 0 <= b < 256) bs =>
  RadixEncoding.digit 3 (bytes_to_bits bs) j = (byte_word bs %/ 2^(3*j)) %% 8.
proof.
  move=> hs hj hb.
  rewrite RadixEncoding.digit_integer 1,2:/# 1:bytes_to_bits_size 1:hs 1:/#.
  have hp : 2^3=8 by rewrite (_:3=2+1) 1:// IntID.exprS 1:// IntID.expr2.
  by rewrite byte_word_value // hp.
qed.

lemma byte_window_valid bs off width :
  all (fun b => 0 <= b < 256) bs =>
  all (fun b => 0 <= b < 256) (take width (drop off bs)).
proof. smt(allP mem_take mem_drop). qed.

lemma read_layer_word bs offset :
  all (fun b => 0 <= b < 256) bs => read_layer bs offset = word_layer bs offset.
proof.
  move=> hb; rewrite /read_layer /word_layer /word_nodes /read_nodes /read_node byte_word_value //.
  exact (byte_window_valid bs (offset+688) 4 hb).
qed.

lemma decode_word bs :
  all (fun b => 0 <= b < 256) bs => decode_signature bs = word_decode bs.
proof.
  move=> hb; rewrite /decode_signature /word_decode.
  have hn : forall n b o, read_nodes n b o = word_nodes n b o by rewrite /read_nodes /read_node /word_nodes.
  rewrite !hn.
  congr.
  + by apply eq_in_mkseq => t ht; rewrite /read_nodes /read_node /word_nodes.
  apply eq_in_mkseq => l hl; exact (read_layer_word bs _ hb).
qed.

lemma hypertree_common bs :
  all (fun b => 0 <= b < 256) bs =>
  hypertree_index (bytes_to_bits bs) = ht_field bs.
proof. by move=> hb; rewrite /ht_field /word_window hypertree_field_bytes. qed.

lemma forest_common bs t :
  0 <= t => all (fun b => 0 <= b < 256) bs =>
  forest_index (bytes_to_bits bs) t = fors_field bs t.
proof. by move=> ht hb; rewrite /fors_field /word_window forest_field_bytes. qed.

lemma wots_common bs j :
  size bs = 32 => 0 <= j < 43 => all (fun b => 0 <= b < 256) bs =>
  RadixEncoding.digit 3 (bytes_to_bits bs) j = wots_field bs j.
proof.
  move=> hs hj hb; rewrite /wots_field /word_window wots_field_bytes //.
  have hp : 2^3=8 by rewrite (_:3=2+1) 1:// IntID.exprS 1:// IntID.expr2.
  by rewrite hp.
qed.
