def REMOVE_OWNER_AT_INDEX_SELECTOR : UInt32 := 0xfbf60db8  -- TODO confirm via `cast sig`

/-! ## Domain tags -/

/-- ASCII `"pqwallet-factory-add-slot"`. The bootstrap key signs
