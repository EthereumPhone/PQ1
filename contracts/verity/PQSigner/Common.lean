def FACTORY_ADD_SLOT_DOMAIN : ByteVec :=
  ByteVec.ofString "pqwallet-factory-add-slot"

/-! ## ERC-4337 v0.6 sentinels for `validateUserOp` -/

def SIG_VALIDATION_SUCCESS : Nat := 0
def SIG_VALIDATION_FAILED : Nat := 1

/-! ## ERC-7201 storage location for `PQMultiOwnable`

    Derivation: `keccak256(abi.encode(uint256(keccak256("pqsigner.storage.PQMultiOwnable")) - 1)) & ~bytes32(uint256(0xff))`.
    Mirrors `_PQ_MULTI_OWNABLE_STORAGE_LOCATION` at
    `contracts/smart-wallet/src/PQMultiOwnable.sol:63-64`. The literal
    value is load-bearing for invariant #6: any change here renames the
    storage namespace, which alters the deployed bytecode and therefore
    the CREATE2 address. -/
def PQ_MULTI_OWNABLE_STORAGE_LOCATION : Bytes32 :=
  Bytes32.ofHex "0x470749eea5ac4a541d6582e535445f94e7300bac9e0e4e5577fd3336b407d000"

/-! ## Owner bytes shape

    An owner is `pkSeed (32) || pkRoot (32)`, both N-masked: the top 16
    bytes carry the actual SPHINCS+C10 128-bit value, the bottom 16
    bytes are zero. The firmware always emits this shape; the on-chain
    verifier feeds the full 32 bytes of each into SHA-256, so a non-zero
    bottom half would simply waste a slot index. -/
structure OwnerBytes where
  pkSeed : Bytes32
  pkRoot : Bytes32
  -- Both halves are required to obey the N-mask. We expose this as a
  -- Prop so callers must prove it before constructing.
  pkSeedNMask : pkSeed.lowHalf = Bytes16.zero
  pkRootNMask : pkRoot.lowHalf = Bytes16.zero

/-- Concatenate to the 64-byte ABI shape stored in `ownerAtIndex`. -/
def OwnerBytes.toBytes (o : OwnerBytes) : ByteVec :=
  o.pkSeed.toByteVec ++ o.pkRoot.toByteVec

end PQSigner.Common
