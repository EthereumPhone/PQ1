import Verity.Prelude

namespace PQSigner.Common

/-! ## Signature sizes -/

/-- Exact length of a SPHINCS+C10 signature, in bytes. -/
def C10_SIG_LEN : Nat := 4008

/-- ABI-encoded `(uint256 ownerIndex, bytes innerSig)` wrapper length.
    Layout: 32 (ownerIndex) + 32 (offset = 0x40) + 32 (length) + ceil(C10_SIG_LEN/32)*32. -/
def SIG_WRAPPER_LEN : Nat := 4128

/-! ## Per-chain usage caps (invariant #7) -/

/-- Type 1 (bootstrap, ownerIndex == 0) sig cap, per chain. -/
def MAX_BOOTSTRAP_USES : Nat := 65536

/-- Type 2 (slot, ownerIndex >= 1) on-chain sig cap, per slot, per chain.
    Shared budget with off-chain EIP-1271 sigs via the combined invariant
    `slotUses[i] + offchainSigCount[i] <= MAX_SLOT_USES`. -/
def MAX_SLOT_USES : Nat := 65536

/-- Max unbacked off-chain sig gap before the firmware refuses a new
    EIP-1271 sig. Firmware-side knob, exposed here for spec coverage of
    `CMD_SIGN_OFFCHAIN` (not currently a Lean theorem target). -/
def MAX_OFFCHAIN_GAP : Nat := 100

/-! ## Wallet storage layout -/

/-- Owner bytes are `pkSeed (32) || pkRoot (32)`. -/
def OWNER_BYTES_LEN : Nat := 64

/-! ## Selectors (Type 2 allowlist) -/

/-- `addOwnerBytes(bytes)` selector. The ONLY selector permitted under
    `ownerIndex == 0`. -/
def ADD_OWNER_BYTES_SELECTOR : UInt32 := 0xdc8b8c1c  -- TODO confirm via `cast sig`

/-- `executeWithOffchainCount(uint256,uint256,address,uint256,bytes)`. -/
def EXECUTE_WITH_OFFCHAIN_COUNT_SELECTOR : UInt32 := 0x14443c57

/-- `executeBatchWithOffchainCount(uint256,uint256,(address,uint256,bytes)[])`. -/
def EXECUTE_BATCH_WITH_OFFCHAIN_COUNT_SELECTOR : UInt32 := 0x7a389933

/-- `removeOwnerAtIndex(uint256,bytes)`. Permitted under Type 2 so the
